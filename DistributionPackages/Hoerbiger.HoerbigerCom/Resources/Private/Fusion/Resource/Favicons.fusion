prototype(Hoerbiger.HoerbigerCom:Resource.Favicons) < prototype(Neos.Fusion:Array) {
    icon_32_32 = Neos.Fusion:Tag {
        tagName = 'link'
        attributes.rel = 'icon'
        attributes.type= 'image/png'
        attributes.sizes = '32x32'
        attributes.href = Neos.Fusion:ResourceUri {
            path = 'resource://Hoerbiger.HoerbigerCom/Public/Favicons/favicon-32x32.png'
            @process.addCacheBuster = ${value + '?cb=' + SitegeistKlarSchiffCacheBuster.get()}
        }
    }

    icon_96_96 = Neos.Fusion:Tag {
        tagName = 'link'
        attributes.rel = 'icon'
