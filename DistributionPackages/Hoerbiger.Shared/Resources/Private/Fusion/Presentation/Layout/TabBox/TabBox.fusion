prototype(Hoerbiger.Shared:Layout.TabBox) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Layout\\TabBox\\TabBoxInterface'

    @styleguide {
        title = 'TabBox'

        props {
            variant = 'regular'
            tabs = 'Text'
        }
    }

    renderer = afx`
        <div class={[
            "[Layout.TabBox (" + presentationObject.variant + ")]",
            presentationObject.variant.isRegular && "grid tabBoxToggle:grid-cols-tabs gap-xl theme-red",
            presentationObject.variant.isHorizontal && "flex flex-col mx-auto"
        ]} data-orientation={presentationObject.variant} >
            <nav class={[
                presentationObject.variant.isRegular && "hidden tabBoxToggle:flex flex-col relative",
                presentationObject.variant.isHorizontal && "flex flex-row justify-center space-x-xs w-full"
            ]}>
                <Neos.Fusion:Loop items={presentationObject.tabs.items}>
                    <label
                        class={[
                            presentationObject.variant.isRegular &&
                            "cursor-pointer py-xs flex items-center justify-between text-lg font-semibold whitespace-nowrap",
                            "border-b text-light-contrast border-light-contrast",
                            presentationObject.variant.isHorizontal && "border-none flex w-3/4 mx-auto",
                            presentationObject.variant.isRegular && "opacity-30",
                            (presentationObject.variant.isRegular && iterator.isFirst) && "opacity-100",
                            presentationObject.variant.isHorizontal && "opacity-100"
                        ]}
                        data-select="tab">
                            <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={item.label} />
                        <Hoerbiger.Shared:Block.Icon @if.1={item.tabIcon} presentationObject={item.tabIcon} />
                    </label>
                </Neos.Fusion:Loop>
            </nav>
            <div class="relative">
                <Neos.Fusion:Loop items={presentationObject.tabs.items}>
                    <div
                        class={[
                            "flex justify-between items-center cursor-pointer min-h-touch",
                            "bg-light my-xs p-xs font-bold tabBoxToggle:hidden shadow tracking-wider color-current"
                        ]}
                        data-select="accordeon-header"
                    >
                        <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={item.label} />
                        <span
                            @if.1={item.accordionIcon}
                            data-select="icon"
                            class={[
                                "transition-all",
                                iterator.isFirst && " rotate-180"
                            ]}
                        >
                            <Hoerbiger.Shared:Block.Icon presentationObject={item.accordionIcon} />
                        </span>
                    </div>
                    <div
                        class={[
                            iterator.isFirst ? "flex" : "hidden",
                            "py-sm tabBoxToggle:py-0"
                        ]}
                        data-select="tab-content"
                    >
                        <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={item.content} />
                    </div>
                </Neos.Fusion:Loop>
            </div>
        </div>
    `
}
