prototype(Hoerbiger.HoerbigerCom:Document.Fragment.Footer) < prototype(Neos.Fusion:Component) {
    renderer = Hoerbiger.HoerbigerCom:Component.Organism.SiteFooter

    @cache {
        mode = 'cached'
        entryIdentifier {
            documentNode = ${documentNode}
        }
        entryTags {
            1 = ${Neos.Caching.nodeTypeTag('Neos.Neos:Document', documentNode)}
        }
    }
}
