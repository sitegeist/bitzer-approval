prototype(Hoerbiger.Shared:Resource.BodyScripts) < prototype(Neos.Fusion:Array) {
    lazyloadJS = Neos.Fusion:Tag {
        tagName = 'script'
        attributes.async = true
        attributes.src = Neos.Fusion:ResourceUri {
            path = 'resource://Sitegeist.Lazybones/Public/JavaScript/lazysizes.min.js'
        }
    }

    accountEngagementTracking = Hoerbiger.Shared:Resource.AccountEngagementTracking

    shared = Neos.Fusion:Tag {
        tagName = 'script'
        attributes.src = Neos.Fusion:ResourceUri {
            path = 'resource://Hoerbiger.Shared/Public/Build/JavaScript/main.min.js'
            @process.stripBaseUri = ${(
                String.replace(
                    value,
                    Configuration.setting('Neos.Flow.http.baseUri'),
                    '/'
                )
            )}
            @process.addCacheBuster = ${value + '?cb=' + SitegeistKlarSchiffCacheBuster.get()}
        }
    }
}
