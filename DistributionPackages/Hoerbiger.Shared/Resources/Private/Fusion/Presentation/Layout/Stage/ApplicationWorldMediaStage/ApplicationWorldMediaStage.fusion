prototype(Hoerbiger.Shared:Layout.Stage.ApplicationWorldMediaStage) < prototype(Hoerbiger.Shared:Layout.AbstractStage) {

    renderer = afx`
        <div class={[
            "[Layout.ApplicationWorldMediaStage (" + presentationObject.variant.value + ")]",
            "relative sm:h-0 sm:pt-ratio-2-1"
        ]}>
            <div
                class="sm:absolute inset-0 z-10"
                @if.1={presentationObject.mediaBackground}
            >
                <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.mediaBackground} />
            </div>
            <div class={[
                "hidden sm:flex sm:absolute z-20 inset-0 bg-light-contrast/50 from-light-contrast/70 to-transparent",
                "sm:bg-transparent sm:bg-gradient-to-t",
                presentationObject.variant.equals('fullMediaTextLeft') &&  "lg:bg-gradient-to-r",
                presentationObject.variant.equals('fullMediaTextRight') &&  "lg:bg-gradient-to-l"

            ]}></div>
            <div class={[
                "sm:absolute sm:inset-md p-md sm:p-sm flex flex-col sm:justify-center items-center top-auto",
                "bg-neutral sm:bg-transparent z-30 text-light",
                (!presentationObject.variant.equals('fullMediaTextCenter')) && "sm:border-2 sm:border-light sm:space-y-xs",
                "sm:top-auto sm:items-start",
                "lg:-translate-y-1/2 lg:bottom-auto lg:top-1/2 lg:max-w-[35%] lg:w-full",
                presentationObject.variant.equals('fullMediaTextLeft') && "lg:right-auto",
                presentationObject.variant.equals('fullMediaTextRight') && "lg:left-auto",
                presentationObject.variant.equals('fullMediaTextCenter') && "text-center mx-auto"
            ]}>
                <div class={[
                    "border-light border-2 p-sm sm:border-0 pb-xs",
                    presentationObject.variant.equals('fullMediaTextCenter') && "w-full"
                ]}>
                    <PackageFactory.AtomicFusion.PresentationObjects:Slot
                        presentationObject={presentationObject.subheadline}
                        @if.1={presentationObject.subheadline}
                    />
                    <div class={[
                        "text-center",
                        (!presentationObject.variant.equals('fullMediaTextCenter')) && "sm:text-left"
                    ]}>
                        <Hoerbiger.Shared:Block.Headline
                            @if.1={presentationObject.headline}
                            presentationObject={presentationObject.headline}
                        />
                    </div>
                    <div class="text-light-contrast mt-xs mb-xs">
                        <Hoerbiger.Shared:Block.Text
                            @if.1={presentationObject.text}
                            presentationObject={presentationObject.text}
                        />
                    </div>
                    <div class="text-light-contrast block sm:flex mb-sm sm:mb-0" @if.1={presentationObject.button}>
                        <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.button} />
                    </div>
                </div>
            </div>
        </div>
    `
}
