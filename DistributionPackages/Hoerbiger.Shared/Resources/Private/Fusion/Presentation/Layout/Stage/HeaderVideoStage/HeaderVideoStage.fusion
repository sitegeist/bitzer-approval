prototype(Hoerbiger.Shared:Layout.Stage.HeaderVideoStage) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Layout\\Stage\\HeaderVideoStage\\HeaderVideoStageInterface'

    renderer = afx`
        <div class={[
            "[Layout.Stage.HeaderVideoStage]",
            "h-screen"
        ]}>
            <div class="overflow-hidden w-full h-screen">
                <div
                    data-select="slider"
                    class="slider flex h-screen"
                >
                    <PackageFactory.AtomicFusion.PresentationObjects:Slot
                        presentationObject={presentationObject.slides}
                    />
                </div>
            </div>
        </div>
    `
}
