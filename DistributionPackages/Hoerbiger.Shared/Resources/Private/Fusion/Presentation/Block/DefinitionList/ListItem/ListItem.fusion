    prototype(Hoerbiger.Shared:Block.DefinitionList.ListItem) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\DefinitionList\\ListItem\\ListItemInterface'

    @styleguide {
        title = 'ListItem'

        props {
            term = '- Add Slot Content -'
            definition = '- Add Slot Content -'
        }
    }

    renderer = afx`
        <dt class="nth-child-4n+1:bg-light min-h-touch px-xs py-ch">
            <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.term} />
        </dt>
        <dd class="nth-child-4n+2:bg-light min-h-touch py-ch px-xs">
            <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.definition} />
        </dd>
    `
}
