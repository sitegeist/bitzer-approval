prototype(Hoerbiger.Shared:Block.Card.ProductCard) < prototype(Hoerbiger.Shared:Block.AbstractCard) {
    renderer = afx`
        <div class={[
            "[Block.Card.ProductCard]",
            "flex flex-col bg-neutral-lighter"
        ]}>
            <div class="w-full h-0 pt-ratio-square relative">
                <div class="absolute inset-xs">
                    <PackageFactory.AtomicFusion.PresentationObjects:Slot
                        @if.1={presentationObject.media}
                        presentationObject={presentationObject.media}
                    />
                </div>
            </div>
            <div class="flex-grow flex flex-col p-xs pt-0 space-y-[.5rem]">
                <div
                    @if.1={presentationObject.header}
                    class="font-sans-bold text-3xl min-h-[4.5rem]"
                >
                    <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.header} />
                </div>
                <div
                    @if.1={presentationObject.buttons}
                    class="flex flex-col divide-y"
                >
                    <Neos.Fusion:Loop items={presentationObject.buttons.items}>
                        <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={item}/>
                    </Neos.Fusion:Loop>
                </div>
            </div>
        </div>
    `
}
