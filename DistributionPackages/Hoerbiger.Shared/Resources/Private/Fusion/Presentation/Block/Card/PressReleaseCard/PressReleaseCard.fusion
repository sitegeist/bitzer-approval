prototype(Hoerbiger.Shared:Block.Card.PressReleaseCard) < prototype(Hoerbiger.Shared:Block.AbstractCard) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\Card\\PressReleaseCard\\PressReleaseCard'
    renderer = afx`
        <div
            data-card="press"
            data-card-type={presentationObject.variant.value}
            class={[
                "[Block.Card.PressReleaseCard (" + presentationObject.variant.value + ")]",
                "flex flex-col space-y-[10px] justify-between",
                presentationObject.variant.equals('meta') && 'bg-hanns p-xs relative',
                presentationObject.variant.equals('hanns') && 'bg-hanns p-xs relative',
                presentationObject.variant.equals('topCompact') && 'group'
            ]}
        >
            <div class="flex flex-col space-y-[10px] justify-between">
                <div
                    @if.1={presentationObject.media}
                    class="pb-[5px]"
                >
                    <PackageFactory.AtomicFusion.PresentationObjects:Slot
                        presentationObject={presentationObject.media}
                    />
                </div>
                <div @if.1={!presentationObject.media && (presentationObject.variant.equals('news') || presentationObject.variant.equals('top'))}>
                    <div class="border-t-[1px] border-service-border"></div>
                </div>

                <div
                    class="uppercase text-xs font-sans-bold text-service-red"
                    @if.1={presentationObject.subheader}
                >
                    <PackageFactory.AtomicFusion.PresentationObjects:Slot
                        presentationObject={presentationObject.subheader}
                    />
                </div>
                <div>
                    <div
                        class="uppercase text-xs text-service-lightGrey font-sans-bold"
                        @if.1={presentationObject.datePublished}
                    >
                        <PackageFactory.AtomicFusion.PresentationObjects:Slot
                            presentationObject={presentationObject.datePublished}
                        />
                    </div>
                    <div
                        class={[
                            (presentationObject.variant.equals('news')) && "font-sans-bold text-xl",
                            (presentationObject.variant.equals('top')) && "font-sans-bold text-sm",
                            (presentationObject.variant.equals('topCompact')) && "font-sans-bold text-sm group-hover:text-service-lightGrey transition-colors",
                            (presentationObject.variant.equals('topNews')) && "text-lg",
                            (presentationObject.variant.equals('yearbook')) && "text-2xl",
                            (presentationObject.variant.equals('hanns')) && "text-2xl",
                            (presentationObject.variant.equals('meta')) && "text-sm"
                        ]}
                        @if.1={presentationObject.header}
                    >
                        <PackageFactory.AtomicFusion.PresentationObjects:Slot
                            presentationObject={presentationObject.header}
                        />
                    </div>
                </div>
                <div
                    class={[
                        "card-hyphens",
                        presentationObject.variant.equals('top') && "text-[14px]",
                        presentationObject.variant.equals('topNews') && "text-[14px]"
                    ]}
                    @if.1={presentationObject.supportingText && !presentationObject.variant.equals('topCompact')}
                >
                    <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.supportingText} />
                </div>
            </div>
            <div
                class=""
                @if.1={presentationObject.buttons && !presentationObject.variant.equals('topCompact')}
            >
                <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.buttons} />
            </div>

            <div
                @if.1={presentationObject.variant.equals('hanns') || presentationObject.variant.equals('meta')}
                class="absolute bottom-0 right-0 h-[12px] w-[125px] bg-[black]"
            >
            </div>
        </div>
    `
}
