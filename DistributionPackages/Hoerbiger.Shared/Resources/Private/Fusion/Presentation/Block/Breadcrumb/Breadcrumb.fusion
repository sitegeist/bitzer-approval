prototype(Hoerbiger.Shared:Block.Breadcrumb) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\Breadcrumb\\BreadcrumbInterface'

    @styleguide {
        title = 'Breadcrumb'

        props {
            links = '- Add Slot Content -'
            currentDocumentItem = 'Current Document'
            glue {
                collectionName = 'Text'
                iconName = 'Text'
            }
        }
    }

    itemStyles = "whitespace-nowrap min-h-touch uppercase flex items-center"

    renderer = afx`
        <div class={[
            "[Block.BreadCrumb]",
            "flex items-center space-x-ch h-full max-h-touch font-semibold text-xs"
        ]}>
            <Neos.Fusion:Loop items={presentationObject.links.items}>
                <span
                    @if.1={iterator.isLast}
                    class={"flex sm:hidden h-[.5rem] flex-shrink-0 text-neutral-darker rotate-180"}
                >
                    <Hoerbiger.Shared:Block.Icon presentationObject={presentationObject.compactGlue} />
                </span>
                <span class={[
                    "text-neutral-darker",
                    props.itemStyles,
                    !iterator.isLast && "hidden sm:flex"
                ]}>
                    <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={item} />
                </span>
                <span class="hidden sm:flex h-[8px] w-[6px] flex justify-center items-center flex-shrink-0 text-neutral-darker">
                    <Hoerbiger.Shared:Block.Icon presentationObject={presentationObject.glue} />
                </span>
            </Neos.Fusion:Loop>
            <span class={[
                "text-light-contrast hidden sm:flex",
                props.itemStyles
            ]}>
                <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.currentDocumentItem} />
            </span>
        </div>
    `
}
