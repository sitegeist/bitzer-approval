prototype(Hoerbiger.Shared:Layout.Grid) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Layout\\Grid\\GridInterface'

    @styleguide {
        title = 'Grid'

        props {
            variant = 'twoColumnsGap'
            content = '- Add Slot Content -'
        }
    }

    renderer = afx`
        <div class={[
            '[Layout.Grid (' + presentationObject.variant + ')]',
            'grid grid-cols-1 w-full',
            presentationObject.variant.isOneColumn && "gap-xl md:gap-md",
            presentationObject.variant.isTwoColumns && "gap-xl lg:grid-cols-2 md:gap-sm",
            presentationObject.variant.isTwoColumnsGap && "gap-xl md:grid-cols-2 md:gap-sm",
            presentationObject.variant.isThreeColumnsGap && "gap-xl md:grid-cols-2 md:gap-x-sm md:gap-y-md lg:grid-cols-3",
            presentationObject.variant.isTwoColumnsFrMaxGap && "gap-xs md:grid-cols-2-1fr-max",
            presentationObject.variant.isIconRight && "gap-x-xs grid-cols-2-1fr-icon items-center",
            presentationObject.variant.isIconLeft && "gap-x-xs grid-cols-2-icon-1fr items-center"
        ]}>
            <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.content} />
        </div>
    `
}
