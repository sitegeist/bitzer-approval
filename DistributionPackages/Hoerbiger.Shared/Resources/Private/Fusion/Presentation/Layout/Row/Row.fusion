prototype(Hoerbiger.Shared:Layout.Row) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Layout\\Row\\RowInterface'

    @styleguide {
        title = 'Row'

        props {
            variant = 'xs'
            content = '- Add Slot Content -'
        }
    }

    renderer = afx`
        <div class={[
            "[Layout.Row (" + presentationObject.variant.value + ")] flex",
            presentationObject.variant.equals('alternateMetalineEllipsis') && "w-full"
        ]}>
            <div class={[
                "flex",
                presentationObject.variant.equals('ch') && "mt-minus-ch ml-minus-ch flex-wrap",
                presentationObject.variant.equals('xs') && "mt-minus-xs ml-minus-xs flex-wrap",
                presentationObject.variant.equals('sm') && "mt-minus-sm ml-minus-sm flex-wrap",
                presentationObject.variant.equals('md') && "mt-minus-md ml-minus-md flex-wrap",
                presentationObject.variant.equals('lg') && "mt-minus-lg ml-minus-lg flex-wrap",
                presentationObject.variant.equals('gallery') && "flex-grow mt-minus-xs ml-minus-xs justify-center items-center flex-wrap",
                presentationObject.variant.equals('alternateMetaline') && "mt-minus-ch ml-minus-ch items-center flex-wrap",
                presentationObject.variant.equals('alternateMetalineEllipsis') && "mt-minus-ch ml-minus-ch items-center flex-nowrap max-w-full min-w-0"
            ]}>
                <Neos.Fusion:Loop items={presentationObject.content.items}>
                    <div
                        class="mt-ch ml-ch text-light-contrast flex-shrink-0"
                        @if.1={(presentationObject.variant.equals('alternateMetaline') || presentationObject.variant.equals('alternateMetalineEllipsis')) && !iterator.isFirst}
                    >ꞏ</div>
                    <div class={[
                        presentationObject.variant.equals('ch') && "mt-ch ml-ch",
                        presentationObject.variant.equals('xs') && "mt-xs ml-xs",
                        presentationObject.variant.equals('sm') && "mt-sm ml-sm",
                        presentationObject.variant.equals('md') && "mt-md ml-md",
                        presentationObject.variant.equals('lg') && "mt-lg ml-lg",
                        presentationObject.variant.equals('gallery') && "mt-xs ml-xs max-w-[350px] max-h-[700px] flex-grow",
                        (presentationObject.variant.equals('alternateMetaline') || presentationObject.variant.equals('alternateMetalineEllipsis')) && "mt-ch ml-ch",
                        (presentationObject.variant.equals('alternateMetaline') || presentationObject.variant.equals('alternateMetalineEllipsis')) && iterator.isOdd && "text-light-contrast",
                        (presentationObject.variant.equals('alternateMetaline') || presentationObject.variant.equals('alternateMetalineEllipsis')) && iterator.isEven && "text-brand",
                        presentationObject.variant.equals('alternateMetalineEllipsis') && "whitespace-nowrap overflow-hidden overflow-ellipsis",
                        presentationObject.variant.equals('alternateMetalineEllipsis') && iterator.isFirst && "flex-shrink-0"
                    ]}>
                        <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={item} />
                    </div>
                </Neos.Fusion:Loop>
            </div>
        </div>
    `
}
