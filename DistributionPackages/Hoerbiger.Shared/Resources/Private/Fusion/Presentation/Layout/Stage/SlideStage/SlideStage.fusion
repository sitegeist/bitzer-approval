prototype(Hoerbiger.Shared:Layout.Stage.SlideStage) < prototype(Hoerbiger.Shared:Layout.AbstractStage) {
    renderer = afx`
        <div class={[
            "[Layout.SlideStage (" + presentationObject.variant + ")]",
            "relative w-full h-full md:h-0 md:pt-ratio-2-1"
        ]}>
            <div
                class="absolute inset-0 z-10 blur"
                @if.1={presentationObject.mediaBackground}
            >
                <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.mediaBackground} />
            </div>
            <div
                @if.1={presentationObject.media}
                class={[
                    "absolute flex items-center justify-center z-20 p-xl w-full h-full",
                    "top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2",
                    "md:top-0 md:bottom-0 md:pt-md md:pb-md md:pl-md md:pr-md md:transform-none md:w-1/2",
                    presentationObject.variant.isFullMediaTextLeft &&  "md:left-1/2 md:right-0",
                    presentationObject.variant.isFullMediaTextRight &&  "md:left-0 md:right-1/2"
                ]}
            >
                <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.media} />
            </div>
            <div class={[
                "absolute z-30  from-light-contrast/70 to-transparent top-1/3",
                "bg-gradient-to-t",
                "inset-0 sm:bg-transparent sm:bg-gradient-to-t sm:top-0",
                presentationObject.variant.isFullMediaTextLeft &&  "lg:bg-gradient-to-r",
                presentationObject.variant.isFullMediaTextRight &&  "lg:bg-gradient-to-l"

            ]}></div>
            <div class={[
                "relative px-md pb-md pt-[80vmin] flex flex-col justify-center bg-transparent space-y-xs z-30 text-light",
                "md:border-2 md:border-light",
                "md:absolute md:inset-md md:p-sm",
                "md:-translate-y-1/2 md:bottom-auto md:top-1/2 md:max-w-[35%] md:w-full",
                presentationObject.variant.isFullMediaTextLeft &&  "md:right-auto",
                presentationObject.variant.isFullMediaTextRight &&  "md:left-auto"
            ]}>
                <PackageFactory.AtomicFusion.PresentationObjects:Slot
                    presentationObject={presentationObject.subheadline}
                    @if.1={presentationObject.subheadline}
                />
                <Hoerbiger.Shared:Block.Headline
                    @if.1={presentationObject.headline}
                    presentationObject={presentationObject.headline}
                />
                <Hoerbiger.Shared:Block.Text
                    @if.1={presentationObject.text}
                    presentationObject={presentationObject.text}
                />
            </div>
        </div>
    `
}
