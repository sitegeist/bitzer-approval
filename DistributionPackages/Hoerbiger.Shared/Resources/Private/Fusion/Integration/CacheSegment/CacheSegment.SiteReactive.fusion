prototype(Hoerbiger.Shared:CacheSegment.SiteReactive) < prototype(Hoerbiger.Shared:CacheSegment) {
    @cache {
        entryIdentifier {
            node = ${documentNode}
        }
        entryTags {
            // whenever homepage changes, the cache segment will flush
            1 = ${Neos.Caching.nodeTag(site)}
        }
    }
}
