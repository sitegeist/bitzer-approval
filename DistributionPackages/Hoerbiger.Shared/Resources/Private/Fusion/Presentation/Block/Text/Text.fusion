prototype(Hoerbiger.Shared:Block.Text) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\Text\\TextInterface'

    @styleguide {
        title = 'Text'

        props {
            variant = 'regular'
            content = '- Add Slot Content -'
        }
    }

    renderer = afx`
        <div class={[
            "[Block.Text (" + presentationObject.variant + ")]",
            "prose",
            presentationObject.canHaveColumns
                ? "column-gap-md lg:column-count-2 max-w-none"
                : presentationObject.variant.isCentered
                    ? "max-w-content-full"
                    : "max-w-content-tight",
            presentationObject.variant.isDefault && "prose-brand",
            presentationObject.variant.isCentered && "prose-brand-contrast font-sans-regular",
            presentationObject.variant.isBrandContrast && "prose-brand-contrast",
            presentationObject.variant.isBrandContrastBold && "prose-brand-contrast font-sans-bold text-lg",
            presentationObject.variant.isNeutralContrast && "prose-neutral-contrast",
            presentationObject.variant.isNeutralContrastFiraPro && "text-neutral-grey font-fira-pro-regular",
            presentationObject.variant.isDecorativeContrast && "prose-decorative-contrast",
            presentationObject.variant.isTransparentContrast && "prose-transparent-contrast",
            presentationObject.variant.isLite && "prose-lite",
            presentationObject.variant.isExcite && "prose-excite",
            presentationObject.variant.isExperience && "prose.experience",
            presentationObject.variant.isServiceContrast && "prose-service"
        ]}>
            <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.content} />
        </div>
    `
}
