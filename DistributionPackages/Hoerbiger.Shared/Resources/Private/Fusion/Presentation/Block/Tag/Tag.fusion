prototype(Hoerbiger.Shared:Layout.Tag) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Layout\\Tag\\TagInterface'

    @styleguide {
        title = 'Tag'

        props {
            tagName = 'Text'
            content = '- Add Slot Content -'
        }
    }

    renderer = Neos.Fusion:Tag {
        tagName = ${presentationObject.tagName}
        content = PackageFactory.AtomicFusion.PresentationObjects:Slot {
            presentationObject = ${presentationObject.content}
        }
    }
}
