prototype(Hoerbiger.Shared:Block.AnchorNavigation) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\AnchorNavigation\\AnchorNavigationInterface'

    @styleguide {
        title = 'AnchorNavigation'

        props {
            variant = 'regular'
            anchors = '- Add Slot Content -'
        }
    }

    renderer = afx`
        <div class="[AnchorNavigation] relative hidden lg:block">
            <div class="absolute anchorPos">
                <div class={[
                    "anchorNav flex w-[60px] h-[80vh] flex-col absolute p-[10px]",
                    "left-0 nav-top-inset z-50 gap-xs overflow-hidden font-sans-regular text-xl"
                ]}>
                    <Neos.Fusion:Loop
                        items={presentationObject.anchors}
                        itemName="anchor"
                    >
                        <div
                            class="vertical-lr flex flex-col gap-1 anchorItem max-h-[12vh]"
                            @if.1={itemKey<6}
                        >
                            <Neos.Fusion:Augmenter class="itemLink rotate-180 truncate">
                                <Hoerbiger.Shared:Block.Link presentationObject={anchor} />
                            </Neos.Fusion:Augmenter>
                            <div class="w-[2px] bg-service-red h-0 animate-progress-nav"></div>
                        </div>
                    </Neos.Fusion:Loop>
                </div>
            </div>
        </div>
    `
}
