prototype(Hoerbiger.Shared:Block.PartialFigureEclipse) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\PartialFigureEclipse\\PartialFigureEclipse'

    @styleguide {
        title = 'PartialFigureEclipse'

        props {
            variant = 'imageLeft'
            figure {
                imageSource = Sitegeist.Kaleidoscope:DummyImageSource {
                height = 1920
                width = 1080
            }
                objectFit = 'cover'
                objectPosition = 'topLeft'
            }
            headline {
                variant = 'regular'
                type = 'h1'
                content = '- Add Slot Content -'
            }
            text {
                variant = 'regular'
                content = '- Add Slot Content -'
            }
            link {
                href = 'https://www.neos.io'
                target = '_self'
                rel = 'Text'
                content = '- Add Slot Content -'
            }
        }
    }

    renderer = afx`
        <div class={[
            "[Block.PartialFigureEclipse]",
            "relative sm:pt-xl",
            "flex flex-col sm:grid sm:grid-cols-2"
        ]}>
            <div class={[
                "sm:col-span-1 relative z-20",
                presentationObject.variant.equals('imageLeft') && "col-start-1",
                presentationObject.variant.equals('imageRight') && "col-start-2"
            ]}>
                <div class={[
                    "sm:absolute sm:top-minus-xl sm:bottom-sm",
                    presentationObject.variant.equals('imageLeft') && "left-md right-minus-md",
                    presentationObject.variant.equals('imageRight') && "left-minus-md right-md"
                ]}>
                    <Hoerbiger.Shared:Block.Figure presentationObject={presentationObject.figure} />
                </div>
            </div>
            <div class={[
                "sm:col-span-1 sm:w-full sm:max-w-[90%] relative z-40",
                "bg-light p-md sm:p-sm border border-neutral-lighter shadow-textbox",
                presentationObject.variant.equals('imageLeft') && "col-start-2 justify-self-start",
                presentationObject.variant.equals('imageRight') && "col-start-1 row-start-1 justify-self-end"
            ]}>
                <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.content} />
            </div>
        </div>
    `
}
