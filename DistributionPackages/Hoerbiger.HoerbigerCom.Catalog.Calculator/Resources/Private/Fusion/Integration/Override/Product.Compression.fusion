prototype(Hoerbiger.HoerbigerCom.Catalog:Document.Product) {
    renderer {
        stylesheets.miniCalculator = Neos.Fusion:Tag {
            tagName = 'link'
            attributes.rel = 'stylesheet'
            attributes.href = Neos.Fusion:ResourceUri {
                path = 'resource://Hoerbiger.HoerbigerCom.Catalog.Calculator/Public/Styles/miniCalculator.css'
                @process.addCacheBuster = ${value + '?cb=' + SitegeistKlarSchiffCacheBuster.get()}
            }
        }
        stylesheets.dialog = Neos.Fusion:Tag {
            tagName = 'link'
            attributes.rel = 'stylesheet'
            attributes.href = Neos.Fusion:ResourceUri {
