root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{yaml,yml}]
indent_size = 2

[{package.json,lerna.json,.babelrc,.eslintrc,.stylelintrc}]
indent_size = 2

[*.{css,js,ts,jsx,tsx}]
indent_style = tab

[Makefile]
indent_style = tab

[*.makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.yaml.example]
indent_size = 2

[*.feature]
indent_size = 2

[ssh-config.txt]
indent_size = 2

[**/Hoerbiger.HoerbigerCom.Catalog.Calculator/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
