prototype(Hoerbiger.Shared:Layout.Stage.ApplicationWorldNavStage) < prototype(Hoerbiger.Shared:Layout.AbstractStage) {
    renderer = afx`
        <div class={[
            "[Layout.ApplicationWorldNavStage (" + presentationObject.variant.value + ")]",
            "relative w-full h-full md:h-0 md:pt-ratio-2-1 bg-[#1B365D]"
        ]}>
            <div
                @if.1={presentationObject.media}
                class={[
                    "absolute flex items-center justify-center z-20 p-sm w-full h-full",
                    "top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2",
                    "md:top-0 md:bottom-0 md:pt-sm md:pb-sm md:pl-sm md:pr-sm md:transform-none md:w-1/2",
                    "md:left-1/2 md:right-0",
                    "max-h-[664px]"
                ]}
            >
                <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.media} />
            </div>

            <div class={[
                "relative px-[5px] pb-md pt-[80vmin] flex flex-col justify-center bg-transparent space-y-xs z-30 text-light",
                (!presentationObject.variant.equals('fullMediaTextCenter')) && "",
                (!presentationObject.variant.equals('fullMediaTextCenter')) && "md:-translate-y-1/2 md:bottom-auto md:top-1/2 md:max-w-[35%] md:w-full",
                "md:absolute md:inset-md md:p-sm",
                presentationObject.variant.equals('fullMediaTextLeft') && "md:right-auto",
                presentationObject.variant.equals('fullMediaTextRight') && "md:left-auto",
                presentationObject.variant.equals('fullMediaTextCenter') && "text-center mx-auto"
            ]}>
            </div>
        </div>
    `
}
