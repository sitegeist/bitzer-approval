prototype(Hoerbiger.Shared:Block.Headline) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\Headline\\HeadlineInterface'

    @styleguide {
        title = 'Headline'

        props {
            variant = 'regular'
            type = 'h1'
            content = '- Add Slot Content -'
        }
    }

    renderer = Neos.Fusion:Tag {
        tagName = ${presentationObject.type}

        attributes.class = Neos.Fusion:DataStructure {
            name = ${"[Block.Headline (" + presentationObject.variant + ")]"}

            large = "font-sans-bold text-3xl sm:text-4xl lg:text-5xl xl:text-6xl"
            large.@if.1 = ${presentationObject.variant.isLarge || presentationObject.variant.isLargeBrand || presentationObject.variant.isLargeWhite}

            medium = "text-3xl lg:text-4xl font-sans-regular"
            medium.@if.1 = ${presentationObject.variant.isMedium || presentationObject.variant.isMediumBrand || presentationObject.variant.isMediumWhite}

            brand = "text-brand"
            brand.@if.1 = ${presentationObject.variant.isLargeBrand || presentationObject.variant.isMediumBrand}

            white = "text-light"
            white.@if.1 = ${presentationObject.variant.isLargeLight || presentationObject.variant.isMediumLight}
        }

        content = PackageFactory.AtomicFusion.PresentationObjects:Slot {
            presentationObject = ${presentationObject.content}
        }
    }
}
