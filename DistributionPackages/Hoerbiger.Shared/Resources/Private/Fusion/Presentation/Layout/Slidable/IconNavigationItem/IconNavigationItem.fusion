prototype(Hoerbiger.Shared:Layout.Slidable.IconNavigationItem) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Layout\\Slidable\\IconNavigationItem\\IconNavigationItemInterface'

    @styleguide {
        title = 'ThumbNavigationItem'

        props {
            icon {
                collectionName = 'shared'
                iconName = 'arrowRight'
            }
            label = 'Text'
        }
    }

    renderer = afx`
        <div class={[
            "[Layout.Slidable.IconNavigationItem]",
            "flex items-center cursor-pointer",
            "bg-transparent lg:space-x-xs justify-center text-transparent border-b-8 border-brand px-md py-xs"
        ]}>
            <div class="hidden lg:flex max-w-[25%] w-full h-full relative">
                <div class="w-[48px] h-[48px]">
                    <Hoerbiger.Shared:Block.Icon presentationObject={presentationObject.icon} />
                </div>
            </div>

            <span class={[
                "hidden md:flex justify-center text-center text-lg font-semibold mx-2 leading-[1.3em]",
                "lg:justify-start lg:text-left uppercase whitespace-nowrap text-light"
            ]}>
                {presentationObject.label}
            </span>
        </div>
    `
}
