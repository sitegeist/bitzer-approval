prototype(Hoerbiger.Shared:Block.SiteHeader) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\SiteHeader\\SiteHeaderInterface'

    @styleguide {
        title = 'SiteHeader'

        props {
            siteLogo {
                variant = 'container'
                href = 'https://www.neos.io'
                target = '_self'
                rel = 'Text'
                content = '- Add Slot Content -'
            }
            mainNavigation = '- Add Slot Content -'
            search = '- Add Slot Content -'
            languageNavigation = '- Add Slot Content -'
            rootLevelIcon {
                collectionName = 'shared'
                iconName = 'chevronDown'
            }
        }
    }
    renderer = afx`
        <header class="w-full bg-light text-light-contrast border-b border-neutral z-header">
            <div class="max-w-content-full mx-auto px-md flex items-center justify-between">
                <!-- HOMELINK + LOGO -->
                <a
                    class="contents"
                    id="logoLink"
                    href="/"
                    target="_self"
                >
                    <img
                        id="logo"
                        width="158"
                        height="55"
                        alt="Logo Hoerbiger"
                        class="h-full max-h-[60px] max-w-[40vw] sm:max-h-[75px] sm:max-w-[60vw] my-3"
                        src={StaticResource.uri('Hoerbiger.Shared', 'Public/Images/logo_colors.png')}
                        {...props.logo}
                    />
                </a>

                <div class="flex items-center space-x-xs">
                    <!-- MAINNAVIGATION -->
                    <div class="hidden menuToggle:flex self-end translate-y-[-26px] space-x-xs uppercase font-sans-bold z-20 hover:z-50">
                        <Neos.Fusion:Loop items={presentationObject.mainNavigation}>
                            <div class="relative group z-10 hover:z-20">
                                <div class="px-2 grid gap-x-ch-xs grid-cols-2-1fr-icon items-center leading-tight">
                                    <Neos.Fusion:Augmenter
                                        data-touch-hover="1"
                                        class="relative after:absolute after:bottom-0 after:w-full after:h-1 after:bg-brand after:translate-y-[26px]"
                                        class.@if.1={item.isActive}
                                    >
                                        <Hoerbiger.Shared:Block.Link presentationObject={item.link} />
                                    </Neos.Fusion:Augmenter>
                                    <div class="text-brand group-hover:-rotate-180 origin-center duration-500 w-max">
                                        <Hoerbiger.Shared:Block.Icon
                                            @if.1={item.subItems}
                                            presentationObject={presentationObject.rootLevelIcon}
                                        />
                                    </div>
                                </div>
                                <div
                                    @if.1={item.subItems}
                                    class={[
                                        "absolute top-full left-minus-xs w-[350px] py-ch px-xs",
                                        "opacity-0 pointer-events-none translate-y-5 duration-500 ease-out group-hover:pointer-events-auto group-hover:opacity-100 group-hover:translate-y-0",
                                        "bg-light text-light-contrast shadow-submenu divide-y divide-light-contrast leading-tight"
                                    ]}
                                >
                                    <Neos.Fusion:Loop items={item.subItems}>
                                        <div class="py-ch px-2 hover:bg-neutral-lighter grid gap-x-ch-xs grid-cols-2-1fr-icon items-center">
                                            <Hoerbiger.Shared:Block.Link presentationObject={item.link} />
                                            <Hoerbiger.Shared:Block.Icon presentationObject={presentationObject.subLevelIcon}/>
                                        </div>
                                    </Neos.Fusion:Loop>
                                </div>
                            </div>
                        </Neos.Fusion:Loop>
                    </div>

                    <div class="flex items-center space-x-2 z-30">
                        <!-- SEARCH -->
                        <Neos.Fusion:Augmenter class="z-20 w-touch h-touch sm:w-[100px] sm:h-[100px]">
                            <PackageFactory.AtomicFusion.PresentationObjects:Slot
                                @if.1={presentationObject.search}
                                presentationObject={presentationObject.search}
                            />
                        </Neos.Fusion:Augmenter>

                        <!-- LANGUAGES -->
                        <div class="hidden menuToggle:flex w-touch h-touch sm:w-[100px] sm:h-[100px] relative text-neutral-contrast z-10">
                            <div class="absolute inset-0 grid grid-col-1 gap-2">
                                <Neos.Fusion:Loop items={presentationObject.languageNavigation}>
                                    <div class={[
                                        "flex items-center justify-center font-sans-bold text-center",
                                        item.isActive ? "bg-neutral" : "bg-neutral-lighter hover:bg-neutral"
                                    ]}>
                                        <Neos.Fusion:Augmenter
                                            @if.1={!item.isActive}
                                            class="w-full h-full flex items-center justify-center"
                                        >
                                        <Hoerbiger.Shared:Block.Link presentationObject={item.link}/>
                                        </Neos.Fusion:Augmenter>
                                        <span @if.1={item.isActive}>
                                            <PackageFactory.AtomicFusion.PresentationObjects:Slot
                                                presentationObject={item.link.content}
                                            />
                                        </span>
                                    </div>
                                </Neos.Fusion:Loop>
                            </div>
                        </div>

                        <!-- OFFCANVAS -->
                        <div
                            id="offcanvas"
                            class="flex menuToggle:hidden bg-neutral-lighter w-touch h-touch sm:w-[100px] sm:h-[100px] relative group z-30"
                        >
                            <a
                                href="#offcanvas"
                                class="absolute inset-0 flex items-center justify-center"
                            >
                                <div class="w-[1.5em] h-[1.5em]">
                                    <svg class="fill-current w-full h-full" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="none" d="M0 0h24v24H0z"></path><path d="M3 4h18v2H3V4zm0 7h18v2H3v-2zm0 7h18v2H3v-2z"></path></svg>
                                </div>
                            </a>

                            <div class={["
                                fixed top-0 h-[100vh] overflow-y-auto w-full -right-full overflow-y-auto",
                                "offcanvas:w-offcanvas offcanvas:right-offcanvas",
                                "group-target:right-0 transition-right duration-500",
                                "bg-neutral-darker border-l-4 border-brand text-light flex flex-col p-sm space-y-xs uppercase"
                            ]}>
                                <a href="#" class="w-touch h-touch text-light flex justify-stretch items-stretch">
                                    <svg class="fill-current w-full h-full" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="none" d="M0 0h24v24H0z"></path><path d="M12 10.586l4.95-4.95 1.414 1.414-4.95 4.95 4.95 4.95-1.414 1.414-4.95-4.95-4.95 4.95-1.414-1.414 4.95-4.95-4.95-4.95L7.05 5.636z"></path></svg>
                                </a>

                                <div class="flex flex-col space-y-ch divide-y">
                                    <nav class="flex font-sans-bold space-x-ch">
                                        <Neos.Fusion:Loop items={presentationObject.languageNavigation}>
                                            <Neos.Fusion:Augmenter
                                                @if.1={!item.isActive}
                                                class="min-h-touch min-w-touch flex items-center justify-center text-center"
                                            >
                                                <Hoerbiger.Shared:Block.Link presentationObject={item.link}/>
                                            </Neos.Fusion:Augmenter>
                                            <div
                                                @if.1={item.isActive}
                                                class="min-h-touch min-w-touch flex items-center justify-center text-center bg-neutral-lighter text-neutral-contrast"
                                            >
                                                {item.link.content}
                                            </div>
                                        </Neos.Fusion:Loop>
                                    </nav>
                                    <nav class="flex flex-col font-sans-bold">
                                        <Neos.Fusion:Loop items={presentationObject.mainNavigation}>
                                            <div class="min-h-touch">
                                                <Hoerbiger.Shared:Block.Link presentationObject={item.link} />
                                            </div>
                                            <Neos.Fusion:Loop @if.1={item.subItems} items={item.subItems}>
                                                <div class="min-h-touch ml-xs">
                                                    <Hoerbiger.Shared:Block.Link presentationObject={item.link} />
                                                </div>
                                            </Neos.Fusion:Loop>
                                        </Neos.Fusion:Loop>
                                    </nav>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>
    `
}
