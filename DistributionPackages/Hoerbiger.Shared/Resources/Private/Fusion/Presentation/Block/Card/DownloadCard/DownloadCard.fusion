prototype(Hoerbiger.Shared:Block.Card.DownloadCard) < prototype(Hoerbiger.Shared:Block.AbstractCard) {
    renderer = afx`
        <div class={[
            "[Block.Card.DownloadCard]",
            "flex flex-col p-xs border border-neutral-lighter shadow-card space-y-ch bg-light"
        ]}>
            <div class="grid grid-cols-2-max-1fr tabBoxToggle:grid-cols-1 2xl:grid-cols-2-max-1fr gap-xs flex-grow">
                <div class="w-[100px] h-0 pt-ratio-square relative border border-neutral-lighter shadow-card">
                    <div class="absolute inset-ch">
                        <PackageFactory.AtomicFusion.PresentationObjects:Slot
                            @if.1={presentationObject.media}
                            presentationObject={presentationObject.media}
                        />
                    </div>
                </div>
                <div class="flex flex-col space-y-ch">
                    <div class="font-semibold">
                        <PackageFactory.AtomicFusion.PresentationObjects:Slot
                            @if.1={presentationObject.header}
                            presentationObject={presentationObject.header}
                        />
                    </div>
                    <PackageFactory.AtomicFusion.PresentationObjects:Slot
                        @if.1={presentationObject.supportingText}
                        presentationObject={presentationObject.supportingText}
                    />
                </div>
            </div>
            <div class="flex flex-col">
                <PackageFactory.AtomicFusion.PresentationObjects:Slot
                    @if.1={presentationObject.buttons}
                    presentationObject={presentationObject.buttons}
                />
                <div class="text-neutral-darker uppercase font-semibold text-sm">
                    <PackageFactory.AtomicFusion.PresentationObjects:Slot
                        @if.1={presentationObject.subheader}
                        presentationObject={presentationObject.subheader}
                    />
                </div>
            </div>
        </div>
    `
}
