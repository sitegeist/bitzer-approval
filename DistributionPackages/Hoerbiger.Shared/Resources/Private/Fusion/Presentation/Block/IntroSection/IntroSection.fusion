prototype(Hoerbiger.Shared:Block.IntroSection) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\IntroSection\\IntroSectionInterface'

    @styleguide {
        title = 'IntroSection'

        props {
            variant = 'fullMedia'
            headline {
                variant = 'regular'
                type = 'h1'
                content = '- Add Slot Content -'
            }
            subheadline = '- Add Slot Content -'
            text {
                variant = 'regular'
                content = '- Add Slot Content -'
            }
            media = '- Add Slot Content -'
        }
    }

    renderer = afx`
        <div class={[
            "Block.IntroSection",
            "relative w-full h-0 pt-ratio-2-1"
        ]}>
            <div
                class="absolute inset-0 z-10"
                @if.1={presentationObject.media}
            >
                <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.media} />
            </div>
            <div class="absolute z-20 inset-0 bg-gradient-to-r from-light-contrast/70 to-transparent"></div>
            <div class={[
                "absolute left-md right-md bottom-md p-sm",
                "lg:-translate-y-1/2 lg:bottom-auto lg:top-1/2 lg:right-auto lg:max-w-[35%] lg:w-full",
                "bg-transparent border-2 border-light flex flex-col space-y-xs z-30 text-light"
            ]}>
                <PackageFactory.AtomicFusion.PresentationObjects:Slot
                    presentationObject={presentationObject.subheadline}
                    @if.1={presentationObject.subheadline}
                />
                <Hoerbiger.Shared:Block.Headline presentationObject={presentationObject.headline} />
                <Hoerbiger.Shared:Block.Text presentationObject={presentationObject.text} />
            </div>
        </div>
    `
}
