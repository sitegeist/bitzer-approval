prototype(Hoerbiger.Shared:Layout.Slidable.ThumbNavigationItem) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Layout\\Slidable\\ThumbNavigationItem\\ThumbNavigationItemInterface'

    @styleguide {
        title = 'ThumbNavigationItem'

        props {
            figure {
                imageSource = Sitegeist.Kaleidoscope:DummyImageSource {
                    height = 1920
                    width = 1080
                }
                isToBeLoadedLazily = true
                objectFit = 'cover'
                objectPosition = 'topLeft'
            }
            label = 'Text'
        }
    }

    renderer = afx`
        <div class={[
            "[Layout.Slidable.ThumbNavigationItem]",
            "flex items-center cursor-pointer overflow-hidden",
            "rounded-[10px] h-xs bg-neutral-lighter",
            "md:h-[70px] w-[350px]"
        ]}>
            <div class="hidden lg:flex w-[90px] h-full relative">
                <div class="absolute w-[150%] h-[150%] right-0 top-1/2 -translate-y-1/2">
                    <Hoerbiger.Shared:Block.Figure
                        @if.1={presentationObject.figure}
                        presentationObject={presentationObject.figure}
                    />
                </div>
            </div>

            <span class={[
                "md:flex px-xs text-lg font-semibold leading-[1.3em]",
                "lg:justify-start lg:text-left font-sans-bold"
            ]}>
                {presentationObject.label}
            </span>
        </div>
    `
}
