prototype(Hoerbiger.Shared:Application.CompactSearchForm) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Application\\CompactSearchForm\\CompactSearchFormInterface'

    @styleguide {
        title = 'CompactSearchForm'

        props {
            targetUri = '/'
        }
    }

    renderer = afx`
        <div
            data-target-uri={presentationObject.targetUri}
            data-labels={presentationObject.labels}
            class={[
                "[Application.CompactSearchForm]",
                "relative"
            ]}
        >
            <div class="absolute flex items-center justify-center text-neutral z-10">
                <Hoerbiger.Shared:Block.Icon presentationObject={presentationObject.searchIcon}/>
            </div>
            <div
                data-select="applicationRoot"
                class="absolute z-20"
            >
            </div>
        </div>
    `
}
