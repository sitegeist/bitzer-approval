prototype(Hoerbiger.Shared:Block.Card.ArticleCard) < prototype(Hoerbiger.Shared:Block.AbstractCard) {
    renderer = afx`
        <div class={[
            "[Block.Card.ArticleCard]",
            "flex flex-col"
        ]}>
            <div class="h-[2.5em] overflow-hidden overflow-ellipsis flex items-center uppercase text-sm font-sans-bold">
                <PackageFactory.AtomicFusion.PresentationObjects:Slot
                    presentationObject={presentationObject.subheader}
                    @if.1={presentationObject.subheader}
                />
            </div>
            <div class="relative w-full h-0 pt-ratio-2-1 mb-2xs">
                <div class="absolute inset-0">
                    <PackageFactory.AtomicFusion.PresentationObjects:Slot
                        presentationObject={presentationObject.media}
                        @if.1={presentationObject.media}
                    />
                </div>
            </div>

            <div class="text-2xl md:text-3xl font-sans-bold mb-ch-xs">
                <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.header} @if.1={presentationObject.header} />
            </div>
            <div class="flex-grow mb-ch">
                <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.supportingText} @if.1={presentationObject.supportingText} />
            </div>
            <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.buttons} @if.1={presentationObject.buttons} />
        </div>
    `
}
