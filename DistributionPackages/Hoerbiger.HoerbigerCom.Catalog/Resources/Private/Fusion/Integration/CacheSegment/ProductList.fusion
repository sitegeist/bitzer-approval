prototype(Hoerbiger.HoerbigerCom.Catalog:CacheSegment.ProductList) < prototype(Hoerbiger.Shared:CacheSegment) {
    @cache {
        entryIdentifier {
            node = ${node}
        }
        entryTags {
            // whenever a product is changed, the cache segment will flush
            1 = ${Neos.Caching.nodeTypeTag('Hoerbiger.HoerbigerCom.Catalog:Document.Product')}
        }
    }
}
