prototype(Hoerbiger.Shared:Layout.AbstractStage) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Layout\\Stage\\Stage'

    @styleguide {
        title = 'Stage'

        props {
            variant = 'fullMedia'
            metaline = '- Add Slot Content -'
            headline {
                variant = 'regular'
                type = 'h1'
                content = '- Add Slot Content -'
            }
            subheadline = '- Add Slot Content -'
            text {
                variant = 'regular'
                content = '- Add Slot Content -'
            }
            media = '- Add Slot Content -'
            mediaBackground = '- Add Slot Content -'
        }
    }
}
