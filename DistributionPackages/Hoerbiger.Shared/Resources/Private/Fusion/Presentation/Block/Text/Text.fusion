prototype(Hoerbiger.Shared:Block.Text) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\Text\\Text'

    @styleguide {
        title = 'Text'

        props {
            variant = 'regular'
            content = '- Add Slot Content -'
        }
    }

    renderer = afx`
        <div class={[
            "[Block.Text (" + presentationObject.variant.value + ")]",
            "prose",
            "[&_a]:font-sans-bold",
            presentationObject.canHaveColumns
                ? "column-gap-md lg:column-count-2 max-w-none"
                : presentationObject.variant.equals('centered')
                    ? "max-w-content-full"
                    : "max-w-content-tight",
            presentationObject.variant.equals('default') && "prose-brand",
            presentationObject.variant.equals('centered') && "prose-brand-contrast font-sans-regular",
            presentationObject.variant.equals('brandContrast') && "prose-brand-contrast",
            presentationObject.variant.equals('brandContrastBold') && "prose-brand-contrast font-sans-bold text-lg",
            presentationObject.variant.equals('neutralContrast') && "prose-neutral-contrast",
            presentationObject.variant.equals('neutralContrastFiraPro') && "text-neutral-grey font-fira-pro-regular",
            presentationObject.variant.equals('transparentContrast') && "prose-transparent-contrast",
            presentationObject.variant.equals('lite') && "prose-lite",
            presentationObject.variant.equals('excite') && "prose-excite",
            presentationObject.variant.equals('experience') && "prose-experience",
            presentationObject.variant.equals('serviceContrast') && "prose-service",
            presentationObject.variant.equals('serviceRed') && "text-service-red font-sans-bold text-[16px] text-center",
            presentationObject.variant.equals('sm') && "text-sm",
            presentationObject.variant.equals('neutralSmall') && "text-small text-light-contrast"
        ]}>
            <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.content} />
        </div>
    `
}
