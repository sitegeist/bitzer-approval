prototype(Hoerbiger.Shared:Layout.Slidable.ThumbNavigationItem) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Layout\\Slidable\\ThumbNavigationItem\\ThumbNavigationItem'

    @styleguide {
        title = 'ThumbNavigationItem'

        props {
            figure {
                imageSource = Sitegeist.Kaleidoscope:DummyImageSource {
                    height = 1920
                    width = 1080
                }
                isToBeLoadedLazily = true
                objectFit = 'cover'
                objectPosition = 'topLeft'
            }
            label = 'Text'
        }
    }

    renderer = afx`
        <div class={[
                "[Layout.Slidable.ThumbNavigationItem " + presentationObject.type.value + "]",
                "sm:flex sm:items-center cursor-pointer md:overflow-hidden",
                "rounded-[10px] md:bg-neutral-lighter",
                "md:h-[70px] w-full",
                presentationObject.type.equals('plainText') && "block h-full bg-none",
                presentationObject.type.equals('default') && "h-xs",
                presentationObject.type.equals('mobile') && "flex h-full bg-none rounded-[10px] bg-neutral-lighter h-[70px] overflow-hidden items-center"
            ]}
            data-type="ThumbNavigationItem"
        >
            <div class={[
                "w-[90px] h-full relative flex-shrink-0",
                presentationObject.type.equals('mobile')
                    ? "flex"
                    : "hidden md:flex"
            ]}>
                <div class="absolute w-[150%] h-[150%] right-0 top-1/2 -translate-y-1/2">
                    <Hoerbiger.Shared:Block.Figure
                        @if.1={presentationObject.figure}
                        presentationObject={presentationObject.figure}
                    />
                </div>
            </div>
            <span
                class={[
                    "px-xs md:pl-0 md:text-lg md:font-semibold leading-[1.3em]",
                    "md:justify-start lg:text-left md:font-sans-bold md:truncate",
                    presentationObject.type.equals('default') && "hidden md:block",
                    presentationObject.type.equals('plainText') && "block",
                    presentationObject.type.equals('mobile') && "block pl-0 text-lg text-semibold font-sans-bold truncate justify-start"
                ]}
            >
                {presentationObject.label}
            </span>
        </div>
    `
}
