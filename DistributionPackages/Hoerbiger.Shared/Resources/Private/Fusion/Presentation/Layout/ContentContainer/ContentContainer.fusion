prototype(Hoerbiger.Shared:Layout.ContentContainer) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Layout\\ContentContainer\\ContentContainerInterface'

    @styleguide {
        title = 'ContentContainer'

        props {
            variant = 'regular'
            content = '- Add Slot Content -'
        }
    }

    renderer = afx`
        <div class={[
            "[Layout.ContentContainer (" + presentationObject.variant + ")]",
            "w-full"
        ]}>
            <div class={[
                presentationObject.variant.isRegular && "max-w-content-full mx-auto p-md bg-light",
                presentationObject.variant.isTight && "max-w-content-66 mx-auto p-md bg-light",
                presentationObject.variant.isRegularSm && "max-w-content-full mx-auto pb-sm sm:p-sm bg-light",
                presentationObject.variant.isRegularX && "max-w-content-full mx-auto px-md bg-light",
                presentationObject.variant.isStageAfterBreadcrumb && "max-w-content-full mx-auto p-sm pt-0 bg-light",
                presentationObject.variant.isRegularStageAfterBreadcrumb && "max-w-content-full mx-auto p-md pt-0 bg-light",
                presentationObject.variant.isBlank && "w-full",
                presentationObject.variant.isBlankY && "w-full py-md"
            ]}>
                <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.content} />
            </div>
        </div>
    `
}
