prototype(Hoerbiger.Shared:Layout.Stack) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Layout\\Stack\\StackInterface'

    @styleguide {
        title = 'Stack'

        props {
            variant = 'regular'
            content = '- Add Slot Content -'
        }
    }

    renderer = afx`
        <div class={[
            "[Layout.Stack (" + presentationObject.variant + ")]",
            "flex flex-col",
            presentationObject.variant.isNoGap && "space-y-0 items-start",
            presentationObject.variant.isInline && "space-y-[1ch] items-start",
            presentationObject.variant.isXs && "space-y-xs items-start",
            presentationObject.variant.isXsStretch && "space-y-xs items-stretch",
            presentationObject.variant.isSm && "space-y-sm items-start",
            presentationObject.variant.isSmStretch && "space-y-sm items-stretch",
            presentationObject.variant.isMd && "space-y-md items-start",
            presentationObject.variant.isMdStretch && "space-y-md items-stretch",
            presentationObject.variant.isLg && "space-y-lg items-start",
            presentationObject.variant.isLgStretch && "space-y-lg items-stretch",
            presentationObject.variant.isXl && "space-y-xl items-start",
            presentationObject.variant.isXlStretch && "space-y-xl items-stretch",
            presentationObject.variant.isMetaPress && "space-y-[14px] items-start w-full items-center",
            presentationObject.variant.isPx16 && "space-y-[16px] items-start"
        ]}>
            <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.content} />
        </div>
    `
}
