prototype(Hoerbiger.Shared:Block.Link) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\Link\\LinkInterface'

    @styleguide {
        title = 'Link'

        props {
            href = 'https://www.neos.io'
            target = '_self'
            rel = 'Text'
            content = '- Add Slot Content -'
        }
    }

    renderer = afx`<dl>
        <dt>href:</dt>
        <dd>{presentationObject.href}</dd>
        <dt>target:</dt>
        <dd>{presentationObject.target}</dd>
        <dt>rel:</dt>
        <dd>{presentationObject.rel}</dd>
        <dt>content:</dt>
        <dd>
            <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.content} />
        </dd>
    </dl>`
}
