prototype(Hoerbiger.Shared:Block.Separator) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\Separator\\SeparatorInterface'

    @styleguide {
        title = 'Separator'

        props {
            variant = 'regular'
        }
    }

    renderer = afx`
        <div
            class={[
                "[Block.Separator ( " + presentationObject.variant + ")]",
                presentationObject.variant.value == "boldRed" && "w-full border-t-8 border-service-red",
                presentationObject.variant.value == "bold" && "border-t-[12px] border-service-border w-1/3",
                presentationObject.variant.value == "fullWidthWithContent" && "w-full border-t-[1px] border-service-border"
            ]}
        >
            <div class={[
                "text-space14 leading-5 pt-ch [&_strong]:font-sans-bold",
                presentationObject.variant.value == "boldRed" && "w-full"
            ]}
                @if.1={presentationObject.content}
            >
                <PackageFactory.AtomicFusion.PresentationObjects:Slot
                    presentationObject={presentationObject.content}
                />
            </div>
        </div>
    `
}
