prototype(Hoerbiger.Shared:Layout.Stage.VideoStage) < prototype(Hoerbiger.Shared:Layout.AbstractStage) {

    renderer = afx`
        <div class={[
            "[Layout.VideoStage (" + presentationObject.variant + ")]",
            "relative w-full"
        ]}>
            <div class="hidden sm:block sm:pb-[100px]">
                <video
                    class="mx-auto relative w-full"
                    autoplay
                    muted
                >
                    <source src={presentationObject.desktopVideoUri} type={'video/mp4'}/>
                    Your browser does not support the video tag.
                </video>
            </div>
            <div class="block sm:hidden">
                <video
                    class="mx-auto relative w-full"
                    autoplay
                    muted
                >
                    <source src={presentationObject.mobileVideoUri} type={'video/mp4'}/>
                    Your browser does not support the video tag.
                </video>
            </div>

            <div>
                <div class={[
                    "relative sm:absolute order-3 mt-[-30%] sm:mt-0 bottom-0 sm:right-0 overflow-hidden z-10",
                    "w-full"
                ]}>
                    <div>
                        <div class="max-w-content-full mx-auto px-md py-contentcontainer">
                            <div class="sm:max-w-[40%]">
                                <Hoerbiger.Shared:Block.Headline
                                    @if.1={presentationObject.headline}
                                    presentationObject={presentationObject.headline}
                                />
                            </div>
                        </div>
                    </div>
                    <div class="bg-triangle-light"></div>
                    <div class="relative bg-light">
                        <div class="max-w-content-full mx-auto px-md py-contentcontainer sm:py-[50px] flex">
                            <div class="sm:max-w-[66%]">
                                <Hoerbiger.Shared:Block.Text
                                    @if.1={presentationObject.text}
                                    presentationObject={presentationObject.text}
                                />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    `
}
