prototype(Hoerbiger.Shared:Block.Tag) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\Tag\\TagInterface'

    @styleguide {
        title = 'Tag'

        props {
            tagName = 'Text'
            variant = 'brandColor'
            content = '- Add Slot Content -'
        }
    }

    renderer = Neos.Fusion:Tag {
        tagName = ${presentationObject.tagName}
        attributes.class = Neos.Fusion:Join {
            brandColor = "text-brand"
            brandColor.@if.1 = ${presentationObject.variant.isBrandColor}
            brandColorBold = "text-warning font-semibold"
            brandColorBold.@if.1 = ${presentationObject.variant.isBrandColorBold}
            brandColorLight = "text-warning font-light"
            brandColorLight.@if.1 = ${presentationObject.variant.isBrandColorLight}
            brandColorContrast = "text-brand-contrast"
            brandColorContrast.@if.1 = ${presentationObject.variant.isBrandColorContrast}
            neutralContrast = "text-neutral-contrast"
            neutralContrast.@if.1 = ${presentationObject.variant.isNeutralContrast}
            transparent = "text-[transparent]"
            transparent.@if.1 = ${presentationObject.variant.isTransparent}
            heightFull = "h-full"
            heightFull.@if.1 = ${presentationObject.variant.isHeightFull}
        }
        content = PackageFactory.AtomicFusion.PresentationObjects:Slot {
            presentationObject = ${presentationObject.content}
        }
    }
}
