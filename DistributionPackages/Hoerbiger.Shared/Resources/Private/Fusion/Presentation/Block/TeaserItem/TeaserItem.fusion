prototype(Hoerbiger.Shared:Block.TeaserItem) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\TeaserItem\\TeaserItem'

    @styleguide {
        title = 'TeaserItem'

        @caseFactory = 'Hoerbiger\\Shared\\Presentation\\Block\\TeaserItem\\TeaserItemFactory'
    }

    renderer = afx`
        <div
            class={[
                "[Block.TeaserItem]",
                "w-full relative flex flex-col"
            ]}
        >
            <div class="flex w-full h-[320px] max-h-[320px] relative">
                <div class="w-full h-0 pt-ratio-16-10 z-30">
                    <div class="absolute inset-0">
                        <PackageFactory.AtomicFusion.PresentationObjects:Slot
                            presentationObject={presentationObject.figure}
                            @if.1={presentationObject.figure}
                        />
                    </div>
                </div>

                <div class="absolute left-[50px] bottom-[50px] z-50">
                    <div class="flex flex-col gap-[20px]">
                        <div
                            class={[
                                "font-sans-bold text-3xl",
                                "drop-shadow-xl",
                                (presentationObject.isFontColorBlack) ? 'text-light-contrast' : 'text-light'
                            ]}
                        >
                            <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.header}/>
                        </div>
                        <div>
                            <Hoerbiger.Shared:Block.Button presentationObject={presentationObject.button} />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    `
}
