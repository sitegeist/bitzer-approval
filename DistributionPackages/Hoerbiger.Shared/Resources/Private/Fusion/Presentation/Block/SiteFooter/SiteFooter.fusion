prototype(Hoerbiger.Shared:Block.SiteFooter) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\SiteFooter\\SiteFooterInterface'

    renderer = afx`
        <footer class={[
            "[Block.SiteFooter]",
            "w-full max-w-screen flex-flex-col items-stretch z-[0]"
        ]}>
            <div class="bg-neutral-contrast border border-t-2 border-t-light font-sans-regular">
                <div class="mx-auto max-w-content-full px-md py-sm">
                    <div
                        data-scrollToTop="scroll"
                        class="w-full flex justify-center mb-sm cursor-pointer p-md lg:p-0"
                    >
                        <svg width="31" height="17" viewBox="0 0 31 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1.35786 16.0357L15.5 1.89355L29.6421 16.0357" stroke="white" stroke-width="2"/>
                        </svg>
                    </div>
                    <div class={[
                        "w-full flex flex-col space-y-lg py-0 lg:py-sm",
                        "md:space-y-10 lg:space-y-0 lg:grid lg:gap-lg lg:grid-cols-2 xl:grid-cols-5"
                    ]}>
                        <div class="hidden col-span-3 xl:col-span-1 xl:flex justify-center items-start">
                            <a href={presentationObject.siteUri}>
                                <img
                                    alt="Logo Hoerbiger"
                                    title="Hoerbiger"
                                    class="max-w-[160px] translate-y-[-30px] block"
                                    width="169"
                                    height="80"
                                    src={presentationObject.logoUri}
                                />
                            </a>
                        </div>
                        <ul class="flex flex-col space-y-3 xl:space-y-5 items-center lg:items-start">
                            <Neos.Fusion:Loop items={presentationObject.primaryNavigationItems.items}>
                                <li>
                                    <Hoerbiger.Shared:Block.Link presentationObject={item}/>
                                </li>
                            </Neos.Fusion:Loop>
                        </ul>
                        <ul class="flex flex-col space-y-3 xl:space-y-5 mx-auto items-center lg:items-start">
                            <Neos.Fusion:Loop items={presentationObject.secondaryNavigationItems.items}>
                                <li>
                                    <Hoerbiger.Shared:Block.Link presentationObject={item}/>
                                </li>
                            </Neos.Fusion:Loop>
                        </ul>
                        <ul class="flex flex-col space-y-3 xl:space-y-5 items-center lg:items-start">
                            <Neos.Fusion:Loop items={presentationObject.tertiaryNavigationItems.items}>
                                <li>
                                    <Hoerbiger.Shared:Block.Link presentationObject={item}/>
                                </li>
                            </Neos.Fusion:Loop>
                        </ul>
                        <div class="flex col-span-3 xl:col-span-1 items-start justify-center lg:items-start">
                            <div class="flex justify-center xl:flex-col gap-2 w-[36px] mb-lg">
                                <Neos.Fusion:Loop items={presentationObject.socialLinks.items}>
                                        <Hoerbiger.Shared:Block.Link presentationObject={item}/>
                                </Neos.Fusion:Loop>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    `
}
