prototype(Hoerbiger.Shared:Layout.Slidable.TextNavigationItem) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Layout\\Slidable\\TextNavigationItem\\TextNavigationItem'

    @styleguide {
        title = 'TextNavigationItem'

        props {
            icon {
                collectionName = 'shared'
                iconName = 'arrowRight'
            }
            label = 'Text'
        }
    }

    renderer = afx`
        <div
            class={[
                "[Layout.Slidable.TextNavigationItem]",
                "flex flex-col",
                "bg-transparent justify-between text-transparent mx-sm md:mx-0 py-[10px] xl:py-[15px]"
            ]}
        >
            <div>
                <span
                    class={[
                        "text-2xl md:text-3xl lg:text-4xl leading-[12px] md:leading-[12px] lg:leading-[1em]",
                        "whitespace-nowrap text-light pb-[5px]"
                    ]}
                    data-select="textNavJumper"
                >
                    {presentationObject.label}
                </span>
            </div>
        </div>
    `
}
