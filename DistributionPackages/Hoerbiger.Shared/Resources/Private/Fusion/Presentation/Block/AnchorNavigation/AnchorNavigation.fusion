prototype(Hoerbiger.Shared:Block.AnchorNavigation) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\AnchorNavigation\\AnchorNavigationInterface'

    @styleguide {
        title = 'AnchorNavigation'

        props {
            variant = 'regular'
            anchors = '- Add Slot Content -'
        }
    }

    renderer = afx`<dl class="[AnchorNavigation]">
        <dt>variant:</dt>
        <dd>{presentationObject.variant}</dd>
        <Neos.Fusion:Loop items={presentationObject.anchors} itemName="anchor">
            <Hoerbiger.Shared:Block.Link presentationObject={anchor} />
        </Neos.Fusion:Loop>
    </dl>`
}
