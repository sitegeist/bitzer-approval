prototype(Hoerbiger.Shared:Layout.Box) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Layout\\Box\\BoxInterface'

    @styleguide {
        title = 'Box'

        props {
            variant = 'textCenter'
            content = '- Add Slot Content -'
        }
    }

    renderer = afx`
        <div id={presentationObject.identifier} class={[
            "[Layout.Box (" + presentationObject.variant + ")]",
            "relative w-full p-md bg-neutral-lighter before:absolute before:top-0 before:left-1/2 before:-translate-x-1/2 before:w-full before:max-w-md before:h-2",
            presentationObject.variant.isTextCenter && "flex items-center p-md",
            presentationObject.variant.isNeutral && "bg-neutral-lighter",
            presentationObject.variant.isDecorative && "before:bg-brand",
            presentationObject.variant.isExcite && "before:bg-excite",
            presentationObject.variant.isExperience && "before:bg-experience",
            presentationObject.variant.isLite && "before:bg-lite",
            presentationObject.variant.isService && "before:bg-service"
        ]}>
            <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.content} />
        </div>
    `
}
