prototype(Hoerbiger.HoerbigerCom.AffiliateDirectory:Application.AffiliateFinder) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\HoerbigerCom\\AffiliateDirectory\\Presentation\\Application\\AffiliateFinder\\AffiliateFinderInterface'

    renderer = afx`
        <div class="[Application.AffiliateFinder] relative">
            <script
                data-select="applicationData"
                type="application/json"
            >
                {presentationObject.applicationData}
            </script>
        </div>
    `
}
