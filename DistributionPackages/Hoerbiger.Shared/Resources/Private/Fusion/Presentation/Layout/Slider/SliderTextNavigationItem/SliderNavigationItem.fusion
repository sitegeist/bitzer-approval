prototype(Hoerbiger.Shared:Layout.Slider.SliderTextNavigationItem) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Layout\\Slider\\SliderTextNavigationItem\\SliderTextNavigationItemInterface'

    @styleguide {
        title = 'SliderTextNavigationItem'

        props {
            icon {
                collectionName = 'shared'
                iconName = 'arrowRight'
            }
            label = 'Text'
        }
    }

    renderer = afx`
        <div
            class={[
                "[Layout.Slider.SliderTextNavigationItem]",
                "flex flex-col cursor-pointer",
                "bg-transparent justify-between smx-sm md:mx-0 py-[10px] xl:py-[15px]"
            ]}
        >
            <div>
                <span
                    class={[
                        "text-2xl md:text-3xl lg:text-5xl leading-[12px] md:leading-[12px] lg:leading-[1em]",
                        "whitespace-nowrap text-slider-grey pb-[5px]"
                    ]}
                    data-select="textNavJumper"
                >
                    {presentationObject.label}
                </span>
            </div>
        </div>
    `
}
