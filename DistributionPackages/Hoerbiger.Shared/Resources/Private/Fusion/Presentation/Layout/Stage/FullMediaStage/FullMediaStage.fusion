prototype(Hoerbiger.Shared:Layout.Stage.FullMediaStage) < prototype(Hoerbiger.Shared:Layout.AbstractStage) {

    renderer = afx`
        <div class={[
            "[Layout.FullMediaStage (" + presentationObject.variant + ")]"
        ]}>
            <div class="relative h-0 pt-ratio-2-1">
                <div class="absolute inset-0 z-10"
                    @if.1={presentationObject.mediaBackground}
                >
                    <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.mediaBackground} />
                </div>
                <div class={[
                    "flex absolute z-20 inset-0 from-light-contrast/50 to-transparent",
                    "bg-transparent bg-gradient-to-t",
                    "lg:bg-gradient-to-r"
                ]}></div>
            </div>
            <div class="relative z-50">
                <div class={[
                    "absolute order-3 right-0 overflow-hidden z-10 bottom-0",
                    "w-full"]}
                >
                    <div>
                        <div class="max-w-content-full mx-auto px-md py-contentcontainer">
                            <div class="lg:max-w-[66%] xl:max-w-[40%]">
                                <Hoerbiger.Shared:Block.Headline
                                    @if.1={presentationObject.headline}
                                    presentationObject={presentationObject.headline}
                                />
                            </div>
                        </div>
                    </div>
                    <div class="bg-triangle-light"></div>
                </div>
            </div>
            <div class="relative bg-light">
                <div class={[
                    "max-w-content-full mx-auto px-md py-contentcontainer flex",
                    presentationObject.variant.isfullMediaTextLeft && "sm:py-[50px]"
                ]}>
                    <div class="lg:max-w-[66%]">
                        <Hoerbiger.Shared:Block.Text
                            @if.1={presentationObject.text}
                            presentationObject={presentationObject.text}
                        />
                        <div class="text-light-contrast block sm:flex my-sm sm:mb-0" @if.1={presentationObject.button}>
                            <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.button} />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    `
}
