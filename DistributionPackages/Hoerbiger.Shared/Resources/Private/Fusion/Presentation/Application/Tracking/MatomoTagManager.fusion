prototype(Hoerbiger.Shared:Application.Tracking.MatomoTagManager) < prototype(Neos.Fusion:Component) {
    baseUri = ''

    renderer = ${"<!-- Matomo -->
                    <script src='"+ props.baseUri +"tracking.js'></script>
                    <script src='https://piwik.hoerbiger.com/matomo.js' async defer></script>
                <!-- End Matomo Code -->"}
}
