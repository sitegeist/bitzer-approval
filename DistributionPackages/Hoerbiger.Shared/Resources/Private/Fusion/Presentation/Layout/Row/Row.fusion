prototype(Hoerbiger.Shared:Layout.Row) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Layout\\Row\\RowInterface'

    @styleguide {
        title = 'Row'

        props {
            variant = 'xs'
            content = '- Add Slot Content -'
        }
    }

    renderer = afx`
        <div class={"[Layout.Row (" + presentationObject.variant + ")] flex"}>
            <div class={[
                "flex flex-wrap",
                presentationObject.variant.isCh && "mt-minus-ch ml-minus-ch",
                presentationObject.variant.isXs && "mt-minus-xs ml-minus-xs",
                presentationObject.variant.isSm && "mt-minus-sm ml-minus-sm",
                presentationObject.variant.isMd && "mt-minus-md ml-minus-md",
                presentationObject.variant.isLg && "mt-minus-lg ml-minus-lg",
                presentationObject.variant.isGallery && "flex-grow mt-minus-xs ml-minus-xs justify-center items-center"
            ]}>
                <Neos.Fusion:Loop items={presentationObject.content.items}>
                    <div class={[
                        presentationObject.variant.isCh && "mt-ch ml-ch",
                        presentationObject.variant.isXs && "mt-xs ml-xs",
                        presentationObject.variant.isSm && "mt-sm ml-sm",
                        presentationObject.variant.isMd && "mt-md ml-md",
                        presentationObject.variant.isLg && "mt-lg ml-lg",
                        presentationObject.variant.isGallery && "mt-xs ml-xs max-w-[350px] max-h-[350px]"
                    ]}>
                        <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={item} />
                    </div>
                </Neos.Fusion:Loop>
            </div>
        </div>
    `
}
