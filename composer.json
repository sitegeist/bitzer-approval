{
    "name": "hoerbiger/hoerbiger-neos-distribution",
    "description": "Hoerbiger Neos Distribution",
    "config": {
        "vendor-dir": "Packages/Libraries",
        "bin-dir": "bin",
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "neos/composer-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "hoerbiger/hoerbigercom": "*",
        "hoerbiger/hoerbigercom-catalog": "*",
        "hoerbiger/hoerbigercom-successstories": "*",
        "hoerbiger/hoerbigercom-pressarchive": "*",
        "hoerbiger/hoerbigercom-application-worlds": "*",
        "hoerbiger/hoerbigercom-affiliatedirectory": "*",
        "hoerbiger/hoerbigercom-catalog-calculator": "*",
        "hoerbiger/hoerbigercom-hr": "*"
    },
    "require-dev": {
        "neos/buildessentials": "^8.3",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^9.6",
        "symfony/css-selector": "~2.8",
        "deployer/deployer": "^6.9",
        "editorconfig-checker/editorconfig-checker": "^10.3",
        "squizlabs/php_codesniffer": "^3.7",
        "sitegeist/magicwand": "~4.4.1",
        "phpstan/phpstan": "^1.10"
    },
    "suggest": {
        "ext-pdo_sqlite": "For running functional tests out-of-the-box this is required"
    },
    "scripts": {
        "post-update-cmd": "Neos\\Flow\\Composer\\InstallerScripts::postUpdateAndInstall",
        "post-install-cmd": "Neos\\Flow\\Composer\\InstallerScripts::postUpdateAndInstall",
        "post-package-update": "Neos\\Flow\\Composer\\InstallerScripts::postPackageUpdateAndInstall",
        "post-package-install": "Neos\\Flow\\Composer\\InstallerScripts::postPackageUpdateAndInstall",

        "flush": [
            "./flow flow:cache:flush --force",
            "./flow flow:package:rescan",
            "./flow doctrine:migrate",
            "./flow resource:publish"
        ],

        "cleanup:php": [
            "rm -rf ./Data/Temporary/*",
            "rm -rf ./Packages/*",
            "rm -rf ./bin/*"
        ],

        "lint:editorconfig": "ec",
        "lint:phpcs": "phpcs --colors --standard=PSR2 ./DistributionPackages/*/Classes --ignore=./DistributionPackages/Hoerbiger.HoerbigerCom.Catalog.Calculator/",
        "lint:phpstan": "phpstan analyse",
        "lint:php": [
            "@lint:phpcs",
            "@lint:phpstan"
        ],
        "lint": [
            "@lint:editorconfig",
            "@lint:php"
        ],

        "test:unit": [
            "bin/phpunit --colors --stop-on-failure -c Build/BuildEssentials/PhpUnit/UnitTests.xml ./DistributionPackages/Hoerbiger.Shared/Tests/Unit/"
        ],
        "test": "@test:unit",

        "clone": [
            "./flow clone:list",
            "./flow clone:preset"
        ],
        "clone:develop": "./flow clone:preset develop",
        "clone:staging": "./flow clone:preset staging",
        "clone:main": "./flow clone:preset main",

        "deploy:develop": "dep deploy develop -vv",
        "deploy:staging": "dep deploy staging -vv",
        "deploy:master": "dep deploy master -vv"
    },
    "repositories": {
        "local": {
            "type": "path",
            "url": "./DistributionPackages/*"
        },
        "inspector-gadget": {
            "type": "git",
            "url": "https://github.com/sitegeist/Sitegeist.InspectorGadget.git"
        },
        "bitzer": {
            "type": "git",
            "url": "https://github.com/sitegeist/bitzer.git"
        },
        "bitzer-approval": {
            "type": "git",
            "url": "https://github.com/sitegeist/bitzer-approval.git"
        }
    }
}
