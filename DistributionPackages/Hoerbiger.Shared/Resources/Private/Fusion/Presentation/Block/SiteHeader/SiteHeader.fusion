prototype(Hoerbiger.Shared:Block.SiteHeader) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\SiteHeader\\SiteHeaderInterface'

    @styleguide {
        title = 'SiteHeader'

        props {
            siteLogo {
                variant = 'container'
                href = 'https://www.neos.io'
                target = '_self'
                rel = 'Text'
                content = '- Add Slot Content -'
            }
            mainNavigation = '- Add Slot Content -'
            search = '- Add Slot Content -'
            languageNavigation = '- Add Slot Content -'
            rootLevelIcon {
                collectionName = 'shared'
                iconName = 'chevronDown'
            }
        }
    }

    renderer = afx`
        <div
            class={[
                "[Block.SiteHeader(" + presentationObject.variant + ")]"
            ]}
            data-site-header-variant={presentationObject.variant}
        >
            <div
                class="h-header"
                @if.1={presentationObject.variant.value == 'regular'}
            ></div>
            <header
                class={[
                    "w-full z-header fixed top-0 h-header",
                    (presentationObject.variant.value == 'regular') && "text-light-contrastTransparent bg-light",
                    (presentationObject.variant.value == 'transparent') && "text-light hover:text-light-contrastTransparent hover:bg-light"
                ]}
            >

                <div
                    class={[
                        "max-w-content-full mx-auto px-md flex ",
                        "flex items-center justify-between h-full "
                    ]}
                >
                    <!-- HOMELINK + LOGO -->
                    <div class="w-xl">
                    <a
                        class="contents w-[200px]"
                        id="logoLink"
                        href={presentationObject.siteUri}
                        target="_self"
                    >
                        <svg viewBox="0 0 162 57" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd" clip-rule="evenodd" d="M16.126 56.3084H11.302L13.269 47.7775H7.16403L5.19704 56.3084H0.374023L5.14104 35.6284H9.96503L8.10204 43.7074H14.208L16.07 35.6284H20.893L16.126 56.3084ZM31.4301 39.2755C29.7721 39.2755 28.9601 40.1194 28.0421 41.6264C27.2761 42.8624 26.6871 44.6414 26.3901 45.9384C25.7951 48.5304 24.9541 52.6615 28.3601 52.6615C30.0181 52.6615 31.1101 51.8464 32.0051 50.3094C32.7771 49.0424 33.3221 47.3244 33.6331 45.9684C33.9791 44.4604 34.2361 42.6814 33.9511 41.2954C33.6661 39.9084 32.9371 39.2755 31.4301 39.2755ZM27.4551 56.6095C24.6511 56.6095 22.8981 55.6454 21.7951 53.3534C20.7791 51.2134 20.7311 48.5304 21.3251 45.9384C22.5831 40.4514 26.2161 35.3254 32.3351 35.3254C35.0791 35.3254 37.0421 36.2304 38.1811 38.4914C39.1961 40.5114 39.2791 43.4354 38.7051 45.9384C38.1661 48.2894 36.8751 51.1534 35.1001 53.1124C32.9631 55.4634 30.2591 56.6095 27.4551 56.6095ZM70.2 35.6283C71.9386 35.6343 73.6709 35.7149 74.9572 36.6839C76.3902 37.7989 76.8612 39.8188 76.3982 41.8378C75.8592 44.1888 74.0052 46.3598 71.5872 47.1738L73.3222 56.3089H67.9552L66.6632 48.1388H63.4222L61.5482 56.3089H56.7252L61.4672 35.6279L70.2 35.6283ZM90.3725 35.628C91.9088 35.631 93.4711 35.6811 94.6108 36.5329C96.0268 37.5869 96.5548 39.0948 96.1058 41.0548C95.5658 43.4058 93.6388 44.9728 91.3448 45.5158L91.3298 45.5759C93.7758 46.0889 95.0748 48.0479 94.4598 50.7309C94.0448 52.5398 92.5928 54.1378 90.9038 55.1928C89.2388 56.2468 87.3445 56.3054 85.6405 56.3087L76.2308 56.3089L80.9988 35.6279L90.3725 35.628ZM58.3393 35.6283L57.4203 39.6373H47.7583L46.7973 43.8283H54.3493L53.4573 47.7163H45.9063L44.8553 52.2993H54.5173L53.5973 56.3083H39.1113L43.8543 35.6283H58.3393ZM86.7047 47.5051L83.2158 47.5049L82.0748 52.4789L85.358 52.4798C86.1917 52.485 87.1835 52.4972 87.9828 52.0278C88.7788 51.5748 89.3648 50.7308 89.5588 49.8868C89.7378 49.1028 89.4428 48.2899 88.8388 47.8969C88.3447 47.5761 87.6095 47.5178 86.9291 47.5072L86.7047 47.5051ZM67.6942 39.3058H65.3042L64.0952 44.5808H66.6042C67.6002 44.5808 68.6642 44.6718 69.6562 44.1588C70.5502 43.6768 71.1932 42.7118 71.4002 41.8078C71.5882 40.9938 71.3062 40.1198 70.7092 39.6968C70.0132 39.1858 68.5982 39.3058 67.6942 39.3058ZM87.7338 39.3058H85.0958L84.0578 43.8279H87.0578C87.9028 43.8279 88.8838 43.8878 89.7318 43.3448C90.4018 42.9228 90.8758 42.1698 91.0338 41.4758C91.2068 40.7218 91.0108 39.9988 90.4378 39.6068C89.8338 39.2148 88.5478 39.3058 87.7338 39.3058ZM117.541 35.2144C117.625 35.2144 117.705 35.2215 117.788 35.2234L117.874 35.2274C122.011 35.3584 124.263 37.9104 124.04 41.9865C124.034 42.0905 124.035 42.1914 124.026 42.2984L123.928 42.3114H119.344C119.398 40.5164 118.614 39.1034 116.529 39.1034C116.086 39.1034 115.676 39.1804 115.294 39.3174C113.855 39.8304 113.124 41.2095 112.42 42.7175C111.958 43.7535 111.6 44.9094 111.39 45.8254C111.184 46.7224 110.987 47.8024 110.953 48.8324C110.955 50.6044 111.218 52.2054 112.99 52.5184C113.195 52.5554 113.411 52.5784 113.649 52.5784C115.759 52.5784 117.832 51.1004 118.195 48.9904H113.99L114.869 45.2755H118.781L123.788 45.2874C123.788 45.2874 122.532 52.0504 118.791 54.7134C115.796 56.8444 112.73 56.5634 112.705 56.5634C107.793 56.5634 105.797 53.1894 105.948 49.0454C105.951 47.9854 106.079 46.8984 106.326 45.8254C107.583 40.3384 111.216 35.2144 117.336 35.2144C117.375 35.2144 117.411 35.2164 117.449 35.2164L117.541 35.2144ZM155.463 35.6283C157.201 35.6343 158.934 35.7149 160.221 36.6839C161.653 37.7989 162.124 39.8188 161.662 41.8378C161.122 44.1888 159.268 46.3598 156.85 47.1738L158.584 56.3089H153.219L151.926 48.1388H148.685L146.812 56.3089H141.988L146.731 35.6279L155.463 35.6283ZM143.532 35.6283L142.612 39.6373H132.95L131.989 43.8283H139.541L138.649 47.7163H131.097L130.046 52.2993H139.709L138.79 56.3083H124.303L129.046 35.6283H143.532ZM155.972 39.6968C155.275 39.1858 153.861 39.3058 152.957 39.3058H150.711L149.501 44.5808H151.867C152.863 44.5808 153.927 44.6718 154.918 44.1588C155.814 43.6768 156.457 42.7118 156.664 41.8078C156.85 40.9938 156.569 40.1198 155.972 39.6968ZM103.582 16.3956L103.579 16.4076L103.437 17.0647C98.2803 18.0627 95.0513 20.0286 95.0513 22.2946C95.0513 25.5716 102.096 28.2276 111.138 28.2276C120.181 28.2276 127.226 25.5716 127.226 22.2946C127.226 20.0856 124.171 18.1616 119.224 17.1416L119.358 16.5046C125.79 17.6176 130.235 19.9936 130.235 22.7496C130.235 26.5696 121.685 29.6676 111.138 29.6676C100.591 29.6676 92.0413 26.5696 92.0413 22.7496C92.0413 19.9007 96.7943 17.4566 103.582 16.3956ZM113.921 0.913452L108.846 22.9265H104.029L109.103 0.913452H113.921ZM118.94 10.4908L116.073 22.9258H111.255L114.121 10.4908H118.94ZM101.151 56.3084H96.3342L101.101 35.6284H105.918L101.151 56.3084Z" fill="currentColor"/>
                        </svg>
                    </a>
                    </div>

                    <nav class="flex items-center justify-end space-x-xs w-full h-full">
                        <!-- MAINNAVIGATION -->
                        <div
                            class="hidden menuToggle:flex space-x-xs font-sans-bold z-20 hover:z-50 w-full pl-lg h-full"
                            data-search="visible"
                        >
                            <Neos.Fusion:Loop items={presentationObject.mainNavigation}>
                                <div class="group z-10 hover:z-20 flex">
                                    <div class="grid gap-x-ch-xs grid-cols-2-1fr-icon items-center leading-tight">
                                        <div
                                            data-touch-hover="1"
                                            data-active-main-link="1"
                                            data-active-main-link.@if.1={item.isActive}
                                            class={[
                                                (presentationObject.variant.value == 'regular' && item.isActive) && "text-neutral-contrast"
                                            ]}
                                        >
                                            <Hoerbiger.Shared:Block.Link presentationObject={item.link} />
                                        </div>
                                        <div class="group-hover:-rotate-180 origin-center duration-500 w-max">
                                            <Hoerbiger.Shared:Block.Icon
                                                @if.1={item.subItems}
                                                presentationObject={presentationObject.rootLevelIcon}
                                            />
                                        </div>
                                    </div>
                                    <div
                                        @if.1={item.subItems}
                                        class={[
                                            "hidden absolute left-0 px-1/2 pb-ch z-20 w-full pl-sm top-header",
                                            "group-hover:block",
                                            "pointer-events-none duration-500 ease-out group-hover:pointer-events-auto",
                                            "bg-light"
                                        ]}
                                    >
                                        <div class="max-w-content-full mx-auto">
                                            <div class="grid grid-cols-3 pl-3xl my-sm">
                                                <Neos.Fusion:Loop items={item.subItems} itemKey={"columnKey"}>
                                                        <div>
                                                            <Neos.Fusion:Loop items={item.subItems}>
                                                                <div
                                                                    @if.1={!(itemKey == 0 && columnKey == 0)}
                                                                    class={[
                                                                        "grid gap-x-ch-xs grid-cols-2-icon-1fr items-center",
                                                                        "[&_span]:hover:text-warning text-light-contrast"
                                                                    ]}
                                                                >
                                                                <span>
                                                                    <Hoerbiger.Shared:Block.Icon presentationObject={presentationObject.subLevelIcon}/>
                                                                </span>
                                                                <Hoerbiger.Shared:Block.Link presentationObject={item.link} />
                                                                </div>
                                                            </Neos.Fusion:Loop>
                                                        </div>
                                                </Neos.Fusion:Loop>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </Neos.Fusion:Loop>
                        </div>

                        <div class="flex items-center space-x-2 z-30">

                            <!-- LANGUAGES -->
                            <div
                                class="hidden menuToggle:flex w-touch h-full z-10 "
                                data-search="visible"
                            >
                                <div class="">
                                    <div class="grid grid-col-1 gap-2 absolute">
                                        <div class="absolute group z-50 hover:border p-ch hover:bg-light -top-[21px]">
                                            <Neos.Fusion:Loop items={presentationObject.languageNavigation}>
                                                <div class={[
                                                    "flex items-center justify-center font-sans-bold text-center cursor-pointer group-hover:border-b"
                                                ]}
                                                    @if={item.isActive}
                                                >
                                                    <span @if.1={item.isActive}>
                                                        <PackageFactory.AtomicFusion.PresentationObjects:Slot
                                                            presentationObject={item.link.content}
                                                        />
                                                    </span>
                                                    <Neos.Fusion:Augmenter class="group-hover:rotate-180">
                                                        <Hoerbiger.Shared:Block.Icon presentationObject={presentationObject.rootLevelIcon}/>
                                                    </Neos.Fusion:Augmenter>
                                                </div>
                                                <div class="hidden group-hover:block z-50" @if.1={item.isActive}>
                                                    <Neos.Fusion:Loop
                                                        itemName="inactiveItem"
                                                        items={presentationObject.languageNavigation}
                                                        @if.1={item.isActive}
                                                    >
                                                        <div class="border-b" >
                                                            <div class={[
                                                                "flex items-center justify-center font-sans-bold text-center top-full",
                                                                "text-neutral  hover:text-standard w-fit"
                                                            ]}
                                                                @if.1={!inactiveItem.isActive}
                                                            >
                                                                <Neos.Fusion:Augmenter
                                                                    class="w-full h-full flex items-center justify-center"
                                                                >
                                                                    <Hoerbiger.Shared:Block.Link presentationObject={inactiveItem.link}/>
                                                                </Neos.Fusion:Augmenter>
                                                            </div>
                                                        </div>
                                                    </Neos.Fusion:Loop>
                                                </div>

                                            </Neos.Fusion:Loop>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- SEARCH -->
                            <Neos.Fusion:Augmenter class="z-20 w-touch h-touch grid place-items-center">
                                <div
                                    data-compact-search="root"
                                    data-target-uri={presentationObject.searchTargetUri}
                                    data-labels={presentationObject.labels}
                                    class={[
                                        "[Application.CompactSearchForm]"
                                    ]}
                                >
                                    <div
                                        data-select="applicationRoot"
                                        class="absolute z-20"
                                    >
                                    </div>
                                </div>
                            </Neos.Fusion:Augmenter>

                            <!-- OFFCANVAS -->
                            <div
                                id="offcanvas"
                                class="flex menuToggle:hidden  w-touch h-touch sm:w-[100px] sm:h-[100px] relative group z-30"
                            >
                                <a
                                    href="#offcanvas"
                                    class="absolute inset-0 flex items-center justify-center"
                                >
                                    <div class="w-[1.5em] h-[1.5em]">
                                        <svg class="fill-current w-full h-full" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="none" d="M0 0h24v24H0z"></path><path d="M3 4h18v2H3V4zm0 7h18v2H3v-2zm0 7h18v2H3v-2z"></path></svg>
                                    </div>
                                </a>
                                <!-- mobile -->
                                <div class={["
                                    fixed top-0 h-screen overflow-y-auto w-full -right-full",
                                    "offcanvas:right-offcanvas",
                                    "group-target:right-0 transition-right duration-500",
                                    "bg-neutral-transparent text-light-contrast flex flex-col space-y-xs uppercase "
                                ]}>

                                    <div class="bg-standard">
                                        <div class="max-w-content-full mx-auto pl-md flex items-center justify-between sm:h-[100px]">
                                            <!-- HOMELINK + LOGO -->
                                            <a
                                                class="contents"
                                                id="logoLink"
                                                href="/"
                                                target="_self"
                                            >
                                                <img
                                                    id="logo"
                                                    width="158"
                                                    height="55"
                                                    alt="Logo Hoerbiger"
                                                    class="h-full max-w-[40vw] sm:max-w-[60vw] my-3"
                                                    src={StaticResource.uri('Hoerbiger.Shared', 'Public/Images/logo_white.svg')}
                                                    {...props.logo}
                                                />
                                            </a>
                                            <div class="flex w-touch h-touch sm:w-[100px] sm:h-[100px] relative z-50">
                                                <a href="#" class="absolute inset-0 text-light flex justify-center items-center font-thin p-[0.5em]">
                                                    <div class="w-[2em] h-[2em]">
                                                    <svg class="fill-current w-full h-full" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="none" d="M0 0h24v24H0z"></path><path d="M12 10.586l4.95-4.95 1.414 1.414-4.95 4.95 4.95 4.95-1.414 1.414-4.95-4.95-4.95 4.95-1.414-1.414 4.95-4.95-4.95-4.95L7.05 5.636z"></path></svg>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                    <div class={["p-md h-full "]}>
                                        <div class="flex flex-col h-full space-y-ch ">

                                            <nav class="flex flex-col font-sans-bold text-[20px]">
                                                <Neos.Fusion:Loop items={presentationObject.mainNavigation}>
                                                    <div>
                                                        <div class="min-h-touch" data-accordion="nav-accordion">
                                                            <Neos.Fusion:Augmenter class="justify-end text-right">
                                                                <div class="flex">
                                                                    <Hoerbiger.Shared:Block.Link presentationObject={item.link}/>
                                                                        <img
                                                                            class="w-[30px] h-[30px] object-contain rounded-full translate-y-[10px] ml-ch"
                                                                            src={StaticResource.uri('Hoerbiger.Shared', 'Public/Images/chevronDownStandard.svg')}
                                                                            data-accimage="nav-image"
                                                                        />
                                                                </div>
                                                            </Neos.Fusion:Augmenter>
                                                        </div>
                                                        <div data-accitem="sub-nav" @if.1={item.subItems} class="hidden text-[16px]">
                                                            <Neos.Fusion:Loop @if.1={item.subItems} items={item.subItems}>
                                                                <Neos.Fusion:Loop items={item.subItems}>
                                                                    <div class="min-h-touch ml-xs">
                                                                        <Neos.Fusion:Augmenter class="justify-end flex items-center text-right pr-[8px]">
                                                                            <Hoerbiger.Shared:Block.Link presentationObject={item.link} />
                                                                            <img
                                                                                class="w-[18px] ml-[16px]"
                                                                                src={StaticResource.uri('Hoerbiger.Shared', 'Public/Images/subMenuArrow.svg')}
                                                                                data-accimage="nav-image"
                                                                            />
                                                                        </Neos.Fusion:Augmenter>
                                                                    </div>
                                                                </Neos.Fusion:Loop>
                                                            </Neos.Fusion:Loop>
                                                        </div>
                                                    </div>
                                                </Neos.Fusion:Loop>
                                            </nav>
                                            <nav class="flex font-sans-bold justify-between space-x-sm mb-sm pt-md">
                                                <Neos.Fusion:Loop items={presentationObject.languageNavigation}>
                                                    <Neos.Fusion:Augmenter
                                                        @if.1={!item.isActive}
                                                        class="bg-light min-h-touch min-w-touch flex items-center justify-center text-center text-light-contrast px-[50px] rounded-full w-1/2"
                                                    >
                                                        <Hoerbiger.Shared:Block.Link presentationObject={item.link}/>
                                                    </Neos.Fusion:Augmenter>
                                                    <div
                                                        @if.1={item.isActive}
                                                        class="bg-standard min-h-touch min-w-touch flex items-center justify-center text-center text-light px-[50px] rounded-full w-1/2"
                                                    >
                                                        {item.link.content}
                                                    </div>
                                                </Neos.Fusion:Loop>
                                            </nav>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </nav>
                </div>

            </header>
        </div>
    `
}
