prototype(Hoerbiger.HoerbigerCom.AffiliateDirectory:Document.AffiliateFinder) <  prototype(Neos.Fusion:Component) {
    renderer = Hoerbiger.HoerbigerCom:Document.Base {
        renderer.head.structuredData.corporation = ${'<script type="application/ld+json">' + AffiliateDirectory.JsonLD.getCorporation(documentNode.context) + '</script>'}
        body = Hoerbiger.Shared:Layout.Page {
            presentationObject = ${AffiliateDirectory.Page.forAffiliateFinder(site, documentNode, documentNode.context.inBackend, site.context)}
        }
    }
}
