prototype(Hoerbiger.Shared:Layout.ContentContainer) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Layout\\ContentContainer\\ContentContainerInterface'

    @styleguide {
        title = 'ContentContainer'

        props {
            variant = 'regular'
            content = '- Add Slot Content -'
        }
    }

    renderer = afx`
        <div class={[
            "[Layout.ContentContainer (" + presentationObject.variant + ")]",
            "w-full",
            presentationObject.variant.isRegularNeutral && "bg-neutral-lighter"
        ]}>
            <div class={[
                presentationObject.variant.isRegular && "max-w-content-full mx-auto px-md py-contentcontainer bg-light",
                presentationObject.variant.isRegularWithoutBottom && "max-w-content-full mx-auto px-md pt-contentcontainer pb-xs bg-light mb-minus-contentcontainer",
                presentationObject.variant.isRegularNeutral && "max-w-content-full mx-auto px-md py-contentcontainer",
                presentationObject.variant.isSnug && "max-w-content-snug mx-auto px-md py-contentcontainer bg-light",
                presentationObject.variant.isTight && "max-w-content-tight mx-auto px-md py-contentcontainer bg-light",
                presentationObject.variant.isRegularSm && "max-w-content-full mx-auto pb-sm sm:p-sm bg-light",
                presentationObject.variant.isRegularX && "max-w-content-full mx-auto px-md bg-light",
                presentationObject.variant.isStageAfterBreadcrumb && "max-w-content-full mx-auto p-sm pt-0 bg-light",
                presentationObject.variant.isRegularStageAfterBreadcrumb && "max-w-content-full mx-auto px-md pb-contentcontainer pt-0 bg-light",
                presentationObject.variant.isBlank && "w-full",
                presentationObject.variant.isBlankY && "w-full px-md py-contentcontainer"

            ]}>
                <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.content} />
            </div>
        </div>
    `
}
