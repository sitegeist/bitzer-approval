prototype(Neos.Neos:ContentCollectionRenderer) {
    itemRenderer {
        default.type = ${String.split(q(node).property('_nodeType.name'), ':')[0] + ':ContentSlot'}
    }

    itemRenderer.@process.addAnchor = Neos.Fusion:Augmenter {
        id = ${Shared.Anchor.extractReadableIdentifierFromLabel(q(node).property('anchorLabel'))}
    }
    itemRenderer.@process.addAnchor.@if.hasAnchor = ${q(node).property('anchorLabel')}
}
