prototype(Hoerbiger.HoerbigerCom:Document.Base) < prototype(Neos.Fusion:Component) {
    title = ${q(documentNode).property('title')}
    titleOverride = ${q(documentNode).property('titleOverride')}

    stylesheets = Hoerbiger.Shared:Resource.StyleSheets
    body = null
    bodyScripts = Hoerbiger.Shared:Resource.BodyScripts
    fontShop = Hoerbiger.Shared:Resource.FontShop

    renderer = Neos.Neos:Page {
        head {
            metaViewport = '<meta name="viewport" content="width=device-width">'
            favicons = Hoerbiger.HoerbigerCom:Resource.Favicons
            stylesheets = ${props.stylesheets}

            titleTag {
                content = ${props.titleOverride ? props.titleOverride : props.title}
                content.@process.environmentPrefix {
                    expression = ${Configuration.setting('Hoerbiger.HoerbigerCom.environmentPrefix') + ' ' + value}
                    @if.isSet = ${!String.isBlank(Configuration.setting('Hoerbiger.HoerbigerCom.environmentPrefix'))}
                }
            }

            javascripts {
                cookies = Hoerbiger.Shared:Resource.CCM19 {
                    domain = ${Configuration.setting('Hoerbiger.Shared.ccm19.domain')}
                    endPoint = ${Configuration.setting('Hoerbiger.Shared.ccm19.endPoint')}
                    apiKey = ${Configuration.setting('Hoerbiger.Shared.ccm19.apiKey')}

                    @if.isEnabled = ${Configuration.setting('Hoerbiger.Shared.ccm19.isEnabled')}
                }
                matomoTagManager = Hoerbiger.Shared:Application.Tracking.MatomoTagManager {
                    @if.isEnabled = ${Configuration.setting('Hoerbiger.HoerbigerCom.tracking.isEnabled')}
                    baseUri = ${String.toString(BaseUri.getConfiguredBaseUriOrFallbackToCurrentRequest(request.httpRequest))}
                }

                fontShop = ${props.fontShop}
            }
        }

        htmlTag.attributes.data-lang = ${documentNode.context.dimensions.language[0]}

        body = ${props.body}
        body.@process.contentElementWrapping {
            expression = Neos.Neos:ContentElementWrapping {
                node = ${documentNode}
            }
        }

        body.@process.addExtraHtml = Neos.Fusion:Join {
            matomoTagManagerNoScript = Hoerbiger.Shared:Application.Tracking.MatomoTagManagerNoScript {
                @if.isEnabled = ${Configuration.setting('Hoerbiger.HoerbigerCom.tracking.isEnabled')}
            }
            default = ${value}
        }

        body.@process.addInfo = Neos.Fusion:Join {
            info = Neos.Fusion:Tag {
                attributes.style = 'margin-top:195px;position:relative;z-index:999;'
                content = Sitegeist.LostInTranslation:Document.TranslationInformation {
                    referenceLanguage = ${Configuration.setting('Hoerbiger.HoerbigerCom.translation.referenceLanguage')}
                }
            }
            content = ${value}
        }

        body.@process.addInfo.@if.onlyListenerLanguages = ${Array.indexOf(Configuration.setting('Hoerbiger.HoerbigerCom.translation.listenerDimensions'), Array.first(node.context.dimensions.language)) > -1}
        lastVisitedNodeScript = null
        bodyScripts = ${props.bodyScripts}
        bodyScripts.@position = 'before closingBodyTag'
    }
}
