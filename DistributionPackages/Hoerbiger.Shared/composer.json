{
    "name": "hoerbiger/shared",
    "type": "neos-hoerbiger",
    "description": "Shared kernel for the Hoerbiger distribution",
    "version": "1.0.0",
    "require": {
        "neos/neos": "~7.1.0",
        "neos/neos-ui": "~7.1.0",
        "neos/seo": "^3.0",
        "neos/swiftmailer": "^7.1",
        "neos/redirecthandler-ui": "^2.4",
        "neos/redirecthandler-neosadapter": "^4.3",
        "neos/redirecthandler-databasestorage": "^5.0",
        "neos/content-repository-dimensionspace": "1.0.x-dev",

        "packagefactory/atomicfusion-presentationobjects": "^3.0",

        "flowpack/nodetemplates": "^1.3",
        "flowpack/elasticsearch-contentrepositoryadaptor": "~8.1",

        "shel/neos-hyphens": "^1.2",

        "sitegeist/klarschiff": "^2.1",
        "sitegeist/monocle": "^7.2",
        "sitegeist/kaleidoscope": "^6.0",
        "sitegeist/lazybones": "^3.0",
        "sitegeist/csvpo": "^1.3",
        "sitegeist/stampede": "^1.1",
