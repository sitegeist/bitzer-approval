prototype(Hoerbiger.HoerbigerCom.SuccessStories:Resource.StyleSheets) < prototype(Hoerbiger.Shared:Resource.StyleSheets) {
    successStories = Neos.Fusion:Tag {
        tagName = 'link'
        attributes.rel = 'stylesheet'
        attributes.href = Neos.Fusion:ResourceUri {
            path = 'resource://Hoerbiger.HoerbigerCom.SuccessStories/Public/Build/Styles/main.min.css'
            @process.stripBaseUri = ${(
                String.replace(
                    value,
                    Configuration.setting('Neos.Flow.http.baseUri'),
                    '/'
                )
            )}
            @process.addCacheBuster = ${value + '?cb=' + SitegeistKlarSchiffCacheBuster.get()}
        }
        @position = 'before shared'
    }
}
