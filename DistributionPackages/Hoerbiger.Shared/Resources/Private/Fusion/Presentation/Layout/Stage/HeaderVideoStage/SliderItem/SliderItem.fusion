prototype(Hoerbiger.Shared:Layout.Stage.HeaderVideoStage.SliderItem) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Layout\\Stage\\HeaderVideoStage\\SliderItem\\SliderItemInterface'

    renderer = afx`
        <div
            data-slider-slide
            class={[
                "[Layout.Stage.HeaderVideoStage.SliderItem]",
                "keen-slider__slide data-keen-slider-pe",
                "w-full min-w-full h-screen"
            ]}
        >
            <div class="h-full">
                <div class="relative h-full">
                    <div class="hidden md:flex h-full">
                        <Hoerbiger.Shared:Block.Video presentationObject={presentationObject.video}/>
                    </div>
                    <div class="flex md:hidden h-full">
                        <Hoerbiger.Shared:Block.Figure presentationObject={presentationObject.figure}/>
                    </div>
                    <div class="absolute inset-0 w-full h-full bg-sliderItem"></div>

                    <div
                        data-fade-in-container
                        class="absolute bottom-0 left-0 pl-lg pb-2xl md:pb-md w-full space-y-sm [&_svg]:text-light fade-in-text"
                    >
                        <div class="flex space-y-lg md:space-y-xs flex-col">
                            <Hoerbiger.Shared:Block.Headline
                                @if.1={presentationObject.headline}
                                presentationObject={presentationObject.headline}
                            />
                            <PackageFactory.AtomicFusion.PresentationObjects:Slot
                                @if.1={presentationObject.text}
                                presentationObject={presentationObject.text}
                            />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    `
}
