prototype(Hoerbiger.HoerbigerCom.AffiliateDirectory:Module.AffiliateManagement.Index) < prototype(Neos.Fusion:Component) {

    widgets = Neos.Fusion:DataStructure {
        affiliateIndex {
            icon = 'fas fa-file-upload'
            title = 'Standorte hochladen'
            uri = ${affiliateUploadForm}
            description = 'Dieses Modul ermöglicht das Hochladen der Standortdatei (Affiliates.(xlsx oder xls))'
        }
    }

    renderer = afx`
        <div class="neos-row-fluid">
            <Neos.Fusion:Loop items={props.widgets} itemName="widget">
                <div class="neos-span4">
                    <div class="widget">
                        <div class="widget-header">
                            <i class={'neos-pull-left ' + widget.icon}></i>
                            <h3>
                                <a href={widget.uri}>{widget.title}</a>
                            </h3>
                        </div>
                        <div class="widget-body">
                            <p>{widget.description}</p>
                        </div>
                        <div class="widget-footer">
                            {widget.footer}
                        </div>
                    </div>
                </div>
            </Neos.Fusion:Loop>
        </div>
    `
}
