prototype(Hoerbiger.Shared:Block.Video) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\Video\\VideoInterface'

    @styleguide {
        title = 'Video'

        props {
            source = 'Text'
            figure = '- Add Slot Content -'
        }
    }

    renderer = afx`
        <div class={[
            "[Block.Video (" + presentationObject.variant.value + ")]",
            "flex justify-center items-center relative bg-[black]",
            presentationObject.caption && "pb-touch",
            (presentationObject.variant.equals('slider') || presentationObject.variant.equals('simpleLoop')) && "w-full h-full"
        ]}>
            <div
                class={[
                    "relative mx-auto",
                    (presentationObject.variant.equals('slider') || presentationObject.variant.equals('simpleLoop')) && "w-full h-full"
                ]}
            >
                <video
                    class={[
                        "mx-auto relative",
                        (!presentationObject.variant.equals('slider') && !presentationObject.variant.equals('simpleLoop')) && "max-h-[70vh]",
                        (presentationObject.variant.equals('slider')) && "w-full h-full object-cover opacity-0 transition-opacity duration-[400ms]",
                        (presentationObject.variant.equals('simpleLoop')) && "w-full h-full object-cover"
                    ]}
                    controls controls.@if.1={!presentationObject.variant.equals('slider') && !presentationObject.variant.equals('simpleLoop')}
                    autoplay autoplay.@if.1={presentationObject.variant.equals('slider') || presentationObject.variant.equals('simpleLoop')}
                    muted muted.@if.1={presentationObject.variant.equals('slider') || presentationObject.variant.equals('simpleLoop')}
                    loop loop.@if.1={presentationObject.variant.equals('slider') || presentationObject.variant.equals('simpleLoop')}
                >
                    <source src={presentationObject.source}/>
                </video>
                <div
                    @if.1={presentationObject.figure && !presentationObject.variant.equals('slider') && !presentationObject.variant.equals('simpleLoop')}
                    data-select="poster"
                    class="absolute inset-0 cursor-pointer"
                >
                    <Hoerbiger.Shared:Block.Figure presentationObject={presentationObject.figure}/>
                    <div class="absolute inset-0 bg-light/30"></div>
                    <div class="w-32 h-32 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
                        <img
                            class="w-full h-full object-contain rounded-full hover:shadow-play"
                            src={StaticResource.uri('Hoerbiger.Shared', 'Public/Images/playCircleVariants/' + presentationObject.variant.value + '.svg')}
                        />
                    </div>
                </div>
                <div
                    @if.1={presentationObject.caption}
                    data-no-pointer-events
                    class="absolute top-100 left-0 right-0 bg-light text-md text-neutral-darker min-h-touch max-h-touch overflow-hidden overflow-ellipsis flex items-center"
                >
                    <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.caption} />
                </div>
            </div>
        </div>
    `
}
