prototype(Hoerbiger.HoerbigerCom:Layout.Page) < prototype(Neos.Fusion:Component) {
    @styleguide {
        title = 'Page'
        props {
            header = Sitegeist.Monocle:Preview.Prototype {
                prototypeName = 'Hoerbiger.HoerbigerCom:Component.Organism.SiteHeader'
            }
            footer = Sitegeist.Monocle:Preview.Prototype {
                prototypeName = 'Hoerbiger.HoerbigerCom:Component.Organism.SiteFooter'
            }
        }
    }

    header = null
    content = null
    footer = null

    renderer = afx`
        {props.header}
        <main class={styles.page}>
            {props.content}
        </main>
        {props.footer}
    `
}
