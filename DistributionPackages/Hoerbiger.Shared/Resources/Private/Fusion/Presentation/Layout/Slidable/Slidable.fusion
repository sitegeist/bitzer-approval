prototype(Hoerbiger.Shared:Layout.Slidable) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Layout\\Slidable\\SlidableInterface'

    @styleguide {
        title = 'Slidable'

        props {
            slides = '- Add Slot Content -'
            thumbs = '- Add Slot Content -'
        }
    }

    thumbnailListClass = ${presentationObject.IsApplicationWorld
    ? [
        'absolute md:bottom-[20px] left-0 right-0 top-0 flex overflow-hidden md:space-x-xs mt-xs mx-xs md:mx-auto ',
        'md:w-[90%] md:justify-around'
    ]
    :
        'absolute top-0 left-0 right-0 flex overflow-hidden space-x-xs mt-xs mx-xs md:relative md:mx-0 md:w-full md:justify-between'
    }

    renderer = afx`
        <div class={[
            "[Layout.Slidable] w-full relative flex flex-col",
            presentationObject.variant.equals('applicationWorld') && "bg-[#1B365D]"
        ]}>
            <div @if.1={presentationObject.headline}
                class={[
                    "relative md:absolute px-md py-sm sm:p-sm z-10 max-w-full md:max-w-[50%]"
                ]}
            >
                <Hoerbiger.Shared:Block.Headline
                    @if.1={presentationObject.headline}
                    presentationObject={presentationObject.headline}
                />
            </div>

            <div
                class="w-full flex overflow-hidden relative"
                data-select="slidable"
                data-slidable-variant={presentationObject.variant.value}
                data-is-application-world={presentationObject.IsApplicationWorld ? "true" : null}
            >
                <Neos.Fusion:Loop items={presentationObject.slides.items}>
                    <div
                        class={[
                            "keen-slider__slide data-keen-slider-pe w-full min-w-full",
                            !presentationObject.variant.equals('applicationWorld') && "max-h-[70vh]",
                            presentationObject.variant.equals('applicationWorld') && "max-h-[664px]"
                    ]}>
                        <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={item} />
                    </div>
                </Neos.Fusion:Loop>
            </div>
            <div
                @if.1={!presentationObject.variant.equals('applicationWorld')}
                data-select="prev"
                class="absolute top-2/4 left-4 w-[18px] h-[34px] -translate-y-2/4 cursor-pointer"
            >
                <img src={StaticResource.uri('Hoerbiger.Shared', 'Public/Images/chevronLeft.svg')} />
            </div>
            <div
                @if.1={!presentationObject.variant.equals('applicationWorld')}
                data-select="next"
                class="absolute top-2/4 right-4 w-[18px] h-[34px] -translate-y-2/4 cursor-pointer"
            >
                <img src={StaticResource.uri('Hoerbiger.Shared', 'Public/Images/chevronRight.svg')} />
            </div>

            <div class="w-full h-[10px] relative overflow-hidden">
                <div
                    data-select="progress"
                    class="absolute left-0 top-0 bottom-0 bg-brand"
                ></div>
            </div>

            <div
                @if.1={presentationObject.thumbs.items}
                class={props.thumbnailListClass}
            >
                <Neos.Fusion:Loop items={presentationObject.thumbs.items}>
                    <Neos.Fusion:Augmenter data-select="jumper">
                        <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={item} />
                    </Neos.Fusion:Augmenter>
                </Neos.Fusion:Loop>
            </div>

            <div
                @if.1={presentationObject.inlineNavigation.items}
                class={[
                    "[Slidable.InlineNavigation] relative p-sm sm:p-0 md:absolute md:top-[110px] lg:top-[150px] md:left-sm pb-sm md:pt-[15px] lg:pt-0"
                ]}
            >
                <Neos.Fusion:Loop items={presentationObject.inlineNavigation.items}>
                    <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={item} />
                </Neos.Fusion:Loop>
            </div>

            <div
                @if.1={presentationObject.dots.items}
                class={[
                    "hidden md:flex justify-center py-[10px] space-x-[10px] absolute w-full mx-auto bottom-[10px]"
                ]}
            >
                <Neos.Fusion:Loop items={presentationObject.dots.items}>
                    <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={item} />
                </Neos.Fusion:Loop>
            </div>
        </div>
    `
}
