prototype(Hoerbiger.Shared:Block.AccordionItem) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\AccordionItem\\AccordionItem'

    @styleguide {
        title = 'AccordionItem'

        @caseFactory = 'Hoerbiger\\Shared\\Presentation\\Block\\AccordionItem\\AccordionItemFactory'
    }

    renderer = afx`
        <div
            class={[
                "[Block.AccordionItem (" + presentationObject.variant.value + ")]",
                "w-full",
                presentationObject.variant.equals("regular") && "bg-neutral-lighter w-full"
            ]}
        >
            <Neos.Fusion:Tag
                tagName={presentationObject.inBackend ? 'div' : 'details'}
                attributes.class={[
                    "group"
                ]}
                attributes.open={["open"]}
                attributes.open.@if.1={presentationObject.isOpen}
            >
                <summary class={[
                    presentationObject.variant.equals("regular") && "group-open:bg-neutral",
                    "flex justify-between items-center",
                    "list-none cursor-pointer",
                    presentationObject.variant.equals("regular") && "px-xs pt-[16px] pb-[13px]"
                ]}>
                    <div class={[
                        presentationObject.variant.equals("regular") && "text-xl font-sans-regular",
                        presentationObject.variant.equals("hannsList") && "font-sans-light text-3xl sm:text-4xl lg:text-5xl xl:text-5xl"
                    ]}>
                        <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.header} />
                    </div>
                    <div>
                        <div class="group-open:hidden pb-[3px] flex">
                            <Hoerbiger.Shared:Block.Icon
                                presentationObject={presentationObject.plusIcon}
                            />
                        </div>
                        <div
                            class={[
                                "pb-[3px] hidden group-open:flex",
                                presentationObject.variant.equals("hannsList") && "rotate-180"
                            ]}
                        >
                            <Hoerbiger.Shared:Block.Icon
                                presentationObject={presentationObject.dashIcon}
                                @if={presentationObject.variant.equals("regular")}
                            />
                            <Hoerbiger.Shared:Block.Icon
                                presentationObject={presentationObject.plusIcon}
                                @if={presentationObject.variant.equals("hannsList")}
                            />
                        </div>
                    </div>
                </summary>
                <section
                    class={[
                        presentationObject.variant.equals("regular") && "p-xs",
                        presentationObject.variant.equals("hannsList") && "pt-xs"
                    ]}
                >
                    <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.content} />
                </section>
            </Neos.Fusion:Tag>
        </div>
    `
}
