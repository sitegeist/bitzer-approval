prototype(Hoerbiger.Shared:Block.AbstractIntroSection) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\IntroSection\\IntroSectionInterface'

    @styleguide {
        title = 'IntroSection'

        props {
            variant = 'fullMedia'
            headline {
                variant = 'regular'
                type = 'h1'
                content = '- Add Slot Content -'
            }
            subheadline = '- Add Slot Content -'
            text {
                variant = 'regular'
                content = '- Add Slot Content -'
            }
            media = '- Add Slot Content -'
        }
    }
}
