prototype(Hoerbiger.Shared:Resource.AccountEngagementTracking) < prototype(Neos.Fusion:Component) {

    piAId = ${Configuration.setting('Hoerbiger.Shared.salesforce.piAId')}
    piHostname = ${Configuration.setting('Hoerbiger.Shared.salesforce.piHostname')}
    piCId = ${Configuration.setting('Hoerbiger.Shared.salesforce.piCId')}

    renderer = ${
        '<script>
            piAId =  ' + props.piAId + ';
            piCId = ' + props.piCId + ';
            piDomain = "' + props.piHostname + '";
            (function() {
                function initializeAccountEngagementScript() {
                    if (!Cookiebot.consent.marketing) {
                        if (pdt) {
                            pdt("revokeConsent");
                        }
                        return;
                    }

                    var s=document.createElement("script");s.type="text/javascript";s.async=true;s.src="//"+piDomain+"/pdt.js?aid="+piAId;
                    var c=document.getElementsByTagName("script")[0];c.parentNode.insertBefore(s,c);
                    window["pdt"] = window["pdt"] || function(){(window["pdt"].cq = window["pdt"].cq || []).push(arguments);};
                    pdt("create", piAId, piCId, piDomain);
                    pdt("hideConsentBanner", Cookiebot.consent.marketing);
                    pdt("sendPageView");
                }
                function async_load(){
                    initializeAccountEngagementScript();
                    if (window.attachEvent) {
                        window.attachEvent("CookiebotOnConsentReady", initializeAccountEngagementScript);
                    } else { window.addEventListener("CookiebotOnConsentReady", initializeAccountEngagementScript, false); }
                }

            if (window.attachEvent) {
                window.attachEvent("onload", async_load);
            } else { window.addEventListener("load", async_load, false); }
            })();
        </script>'
    }
}
