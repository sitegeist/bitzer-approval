prototype(Hoerbiger.Shared:Block.ImageSlider) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\ImageSlider\\ImageSlider'

    @styleguide {
        title = 'ImageSlider'
    }

    renderer = afx`
        <div
            class={[
                '[Block.ImageSlider] select-none overflow-hidden group w-full',
                '[--slide-spacing:16px] xl:[--slide-spacing:28px]'
            ]}
            data-interval={presentationObject.interval}
        >
            <div class='overflow-visible embla__viewport flex relative'>
                <div
                    class={[
                        'flex touch-pan-y touch-pinch-zoom ml-[calc(var(--slide-spacing)*-1)]'
                    ]}
                >
                    <PackageFactory.AtomicFusion.PresentationObjects:Collection presentationObject={presentationObject.content} />
                </div>
                <button
                    class={[
                        "absolute p-[12px] top-1/2 -translate-y-1/2 left-xs bg-service-darker text-brand-contrast rounded-full",
                        "embla__button--prev disabled:opacity-20 opacity-100 [&>svg]:fill-current group-[.slider-inactive]:hidden"
                    ]}
                    type="button"
                >
                    <Hoerbiger.Shared:Block.Icon presentationObject={presentationObject.prevSlideIcon} />
                </button>

                <button
                    class={[
                        "absolute p-[12px] top-1/2 -translate-y-1/2 right-xs bg-service-darker text-brand-contrast rounded-full",
                        "embla__button--next disabled:opacity-20 opacity-100 [&>svg]:fill-current group-[.slider-inactive]:hidden"
                    ]}
                    type="button"
                >
                    <Hoerbiger.Shared:Block.Icon presentationObject={presentationObject.nextSlideIcon} />
                </button>
            </div>

            <div
                class={[
                    'lightbox',
                    'fixed inset-0 z-[999] flex items-center justify-center',
                    'bg-[black]/90 cursor-zoom-out',
                    'opacity-0 pointer-events-none p-md',
                    'data-[open]:opacity-100 data-[open]:pointer-events-auto',
                    'transition-opacity duration-200'
                ]}
                role="dialog"
                aria-modal="true"
                aria-hidden="true"
            >
                <div class="h-full w-full flex flex-col items-center justify-center">
                    <img
                        class={[
                            'object-cover select-none m-auto max-w-full max-h-full'
                        ]}
                        alt=""
                    />
                    <figcaption class="text-brand-contrast text-sm text-center pt-sm"></figcaption>
                    </div>
            </div>
        </div>
    `
}
