prototype(Hoerbiger.Shared:Layout.Page) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Layout\\Page\\PageInterface'

    @styleguide {
        title = 'Page'

        props {
            siteHeader {
            }
            content = '- Add Slot Content -'
            siteFooter {
            }
        }
    }

    renderer = afx`
        <div
            class={[
                "[Layout.Page]",
                "flex flex-col min-h-screen w-full max-w-[100vw] overflow-hidden",
                "text-light-contrast bg-light font-sans-light text-base leading-6"
            ]}
            style="word-break:normal;"
        >
            <Hoerbiger.Shared:Block.SiteHeader presentationObject={presentationObject.siteHeader} />
            <main class="flex-grow flex flex-col items-stretch z-content">
                <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.content} />
            </main>
            <Hoerbiger.Shared:Block.SiteFooter presentationObject={presentationObject.siteFooter} />
        </div>
    `
}
