prototype(Hoerbiger.HoerbigerCom.PressArchive:CacheSegment.PressReleaseList) < prototype(PackageFactory.AtomicFusion.PresentationObjects:CacheSegment) {
    @cache {
        entryIdentifier {
            node = ${node}
        }
        entryTags {
            1 = ${Neos.Caching.nodeTag(node)}
            2 = ${Neos.Caching.nodeTypeTag('Hoerbiger.HoerbigerCom.PressArchive:Document.PressRelease', node)}
            3 = ${Neos.Caching.nodeTypeTag('Hoerbiger.HoerbigerCom.PressArchive:Document.HannsRelease', node)}
            4 = ${Neos.Caching.nodeTypeTag('Hoerbiger.HoerbigerCom.PressArchive:Document.YearbookRelease', node)}
        }
    }
}
