prototype(Hoerbiger.Shared:Block.SiteFooter) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\SiteFooter\\SiteFooterInterface'

    renderer = afx`
        <footer class={[
            "[Block.SiteFooter]",
            "w-full max-w-screen flex-flex-col items-stretch z-content"
        ]}>
            <div class="bg-triangle"></div>
            <div
                @if.1={presentationObject.contactFormLink}
                class="bg-neutral-lighter "
            >
                <div class="mx-auto max-w-content-full px-md py-md sm:py-sm">
                    <Hoerbiger.Shared:Block.ContactFormLink presentationObject={presentationObject.contactFormLink} />
                </div>
            </div>
            <div class="bg-neutral-darker border border-t-4 border-t-brand font-sans-bold">
                <div class="mx-auto max-w-content-full py-lg px-xl md:px-md md:py-md">
                    <div class={[
                        "w-full flex flex-col space-y-lg",
                        "md:space-y-10 lg:space-y-0 lg:grid lg:gap-lg lg:grid-cols-2 xl:grid-cols-5"
                    ]}>
                        <div class="col-span-3 xl:col-span-1 flex justify-center items-start">
                            <a href={presentationObject.siteUri}>
                                <img
                                    alt="Logo Hoerbiger"
                                    title="Hoerbiger"
                                    class="max-w-[240px]"
                                    width="233"
                                    height="80"
                                    src={presentationObject.logoUri}
                                />
                            </a>
                        </div>
                        <ul class="flex flex-col space-y-3 xl:space-y-5">
                            <Neos.Fusion:Loop items={presentationObject.primaryNavigationItems.items}>
                                <li>
                                    <Hoerbiger.Shared:Block.Link presentationObject={item}/>
                                </li>
                            </Neos.Fusion:Loop>
                        </ul>
                        <ul class="flex flex-col space-y-3 xl:space-y-5">
                            <Neos.Fusion:Loop items={presentationObject.secondaryNavigationItems.items}>
                                <li>
                                    <Hoerbiger.Shared:Block.Link presentationObject={item}/>
                                </li>
                            </Neos.Fusion:Loop>
                        </ul>
                        <ul class="flex flex-col space-y-3 xl:space-y-5">
                            <Neos.Fusion:Loop items={presentationObject.tertiaryNavigationItems.items}>
                                <li>
                                    <Hoerbiger.Shared:Block.Link presentationObject={item}/>
                                </li>
                            </Neos.Fusion:Loop>
                        </ul>
                        <div class="flex col-span-3 xl:col-span-1 items-start justify-center">
                            <div class="flex justify-center xl:flex-col gap-2">
                                <Neos.Fusion:Loop items={presentationObject.socialLinks.items}>
                                    <Hoerbiger.Shared:Block.Link presentationObject={item}/>
                                </Neos.Fusion:Loop>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    `
}
