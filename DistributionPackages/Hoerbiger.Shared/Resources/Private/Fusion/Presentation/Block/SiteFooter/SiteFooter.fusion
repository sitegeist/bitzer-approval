prototype(Hoerbiger.Shared:Block.SiteFooter) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\SiteFooter\\SiteFooterInterface'

    @styleguide {
        title = 'SiteFooter'

        props {
            socialLinks = '- Add Slot Content -'
            navigationLinks = '- Add Slot Content -'
        }
    }

    renderer = afx`
        <footer class={[
            "[Block.SiteFooter]",
            "w-full max-w-screen flex-flex-col items-stretch z-content"
        ]}>
            <div
                @if.1={presentationObject.contactFormLink}
                class="bg-neutral-lighter "
            >
                <div class="mx-auto max-w-content-full px-md py-md sm:py-sm">
                    <Hoerbiger.Shared:Block.ContactFormLink presentationObject={presentationObject.contactFormLink} />
                </div>
            </div>
            <div class="bg-neutral-darker border border-t-4 border-t-brand">
                <div class="mx-auto max-w-content-full px-md py-md sm:py-xs flex flex-col items-center lg:flex-row sm:space-x-sm space-y-md lg:space-y-0">
                    <div class="flex w-full justify-between items-center ">
                        <img
                            alt="Logo Hoerbiger"
                            class="max-w-[150px]"
                            width="233"
                            height="80"
                            src={StaticResource.uri('Hoerbiger.Shared', 'Public/Images/logo_white.png')}
                        />
                        <div
                            @if.1={presentationObject.socialLinks}
                            class="flex text-light space-x-xs"
                        >
                            <Neos.Fusion:Loop items={presentationObject.socialLinks.items} >
                                <Neos.Fusion:Augmenter class="max-w-touch">
                                    <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={item} />
                                </Neos.Fusion:Augmenter>
                            </Neos.Fusion:Loop>
                        </div>
                    </div>
                    <div class="flex items-center space-x-xs">

                        <div
                            @if.1={presentationObject.navigationLinks}
                            class="flex flex-wrap md:flex-nowrap justify-center space-x-sm md:space-x-xs "
                        >
                            <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.navigationLinks} />
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    `
}
