prototype(Hoerbiger.Shared:Block.Button) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\Button\\Button'

    @styleguide {
        title = 'Button'

        props {
            type = 'link'
            variant = 'cta'
            content = '- Add Slot Content -'
            href = 'https://www.neos.io'
            target = 'Text'
            rel = 'Text'
        }
    }

    renderer = Neos.Fusion:Tag {
        tagName = Neos.Fusion:Case {
            link {
                condition = ${presentationObject.type.equals('link')}
                renderer = 'a'
            }

            default {
                @position = 'end 9999'
                condition = true
                renderer = 'span'
            }
        }

        attributes {
            class = Neos.Fusion:DataStructure {
                name = '[Block.Button]'

                base = "cursor-pointer whitespace-nowrap overflow-ellipsis flex justify-center items-center space-x-[1em] min-h-touch max-h-touch"
                text = "font-semibold"

                cta = "bg-brand text-brand-contrast font-sans-bold"
                cta.@if.1 = ${presentationObject.variant.equals('cta')}

                ctaContrast = "bg-light text-standard font-sans-bold"
                ctaContrast.@if.1 = ${presentationObject.variant.equals('ctaContrast')}

                contrast = "font-sans-bold"
                contrast.@if.1 = ${presentationObject.variant.equals('contrast')}

                plain = "font-sans-bold px-0 [&_svg]:pt-[3px]"
                plain.@if.1 = ${presentationObject.variant.equals('plain')}

                notPlain = "px-8 rounded-full "
                notPlain.@if.1 = ${!presentationObject.variant.equals('plain') && !presentationObject.variant.equals('contrast')}
            }

            href = ${presentationObject.href}
            href.@if.1 = ${presentationObject.type.equals('link')}

            target = ${presentationObject.target}
            target.@if.1 = ${presentationObject.type.equals('link')}

            rel = ${presentationObject.rel}
            rel.@if.1 = ${presentationObject.type.equals('link')}
        }

        content = PackageFactory.AtomicFusion.PresentationObjects:Slot {
            presentationObject = ${presentationObject.content}
        }
    }
}
