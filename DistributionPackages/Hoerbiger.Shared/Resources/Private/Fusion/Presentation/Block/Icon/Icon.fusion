prototype(Hoerbiger.Shared:Block.Icon) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\Icon\\IconInterface'

    @styleguide {
        title = 'Icon'

        props {
            collectionName = 'shared'
            iconName = 'arrowRight'
        }
    }


    renderer = Sitegeist.Stampede:Icon {
        collection = ${presentationObject.collectionName}
        icon = ${presentationObject.iconName}
        class = Neos.Fusion:Join {
            name = ${"[Block.Icon (" + presentationObject.collectionName + "::" + presentationObject.iconName + ")]"}
            // base = "fill-current"
            @glue = " "

            size_1 = "w-[1em] h-[1em]"
            size_1.@if.1 = ${presentationObject.size.isSize_1}

            size_1_5 = "w-[1.5em] h-[1.5em]"
            size_1_5.@if.1 = ${presentationObject.size.isSize_1_5}

            size_2 = "w-[2em] h-[2em]"
            size_2.@if.1 = ${presentationObject.size.isSize_2}

            size_2_5 = "w-[2.5em] h-[2.5em]"
            size_2_5.@if.1 = ${presentationObject.size.isSize_2_5}

            size_3 = "w-[3em] h-[3em]"
            size_3.@if.1 = ${presentationObject.size.isSize_3}

            size_4 = "w-[4em] h-[4em]"
            size_4.@if.1 = ${presentationObject.size.isSize_4}

            size_parent = "w-full h-full"
            size_parent.@if.1 = ${presentationObject.size.isSizeParent}



            colorCurrent = "fill-current"
            colorCurrent.@if.1 = ${presentationObject.color.isCurrent}

            colorBrand = "fill-brand"
            colorBrand.@if.1 = ${presentationObject.color.isBrand}

            colorWhite = "fill-white"
            colorWhite.@if.1 = ${presentationObject.color.isWhite}

            colorExcite = "fill-excite"
            colorExcite.@if.1 = ${presentationObject.color.isExcite}

            colorExciteContrast = "fill-excite-contrast"
            colorExciteContrast.@if.1 = ${presentationObject.color.isExciteContrast}

            colorExperience = "fill-experience"
            colorExperience.@if.1 = ${presentationObject.color.isExperience}

            colorExperienceContrast = "fill-experience-contrast"
            colorExperienceContrast.@if.1 = ${presentationObject.color.isExperienceContrast}

            colorLite = "fill-lite"
            colorLite.@if.1 = ${presentationObject.color.isLite}

            colorLiteContrast = "fill-lite-contrast"
            colorLiteContrast.@if.1 = ${presentationObject.color.isLiteContrast}

            colorServiceContrast = "fill-service-contrast"
            colorServiceContrast.@if.1 = ${presentationObject.color.isServiceContrast}


        }
        style = null
        inline = true
    }
}
