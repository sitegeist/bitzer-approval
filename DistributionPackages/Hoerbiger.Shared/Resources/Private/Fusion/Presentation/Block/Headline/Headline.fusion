prototype(Hoerbiger.Shared:Block.Headline) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\Headline\\HeadlineInterface'

    @styleguide {
        title = 'Headline'

        props {
            variant = 'regular'
            type = 'h1'
            content = '- Add Slot Content -'
        }
    }

    renderer = Neos.Fusion:Tag {
        tagName = ${presentationObject.type}

        attributes.class = Neos.Fusion:DataStructure {
            name = ${"[Block.Headline (" + presentationObject.type + "_" + presentationObject.size + "_" + presentationObject.color + ")]"}

            extraLarge = "font-sans-regular font-bold text-3xl sm:text-4xl lg:text-extraLarge xl:text-extraLarge"
            extraLarge.@if.1 = ${presentationObject.size.isExtraLarge}

            superLarge = "font-sans-regular text-3xl sm:text-4xl lg:text-5xl xl:text-5xl"
            superLarge.@if.1 = ${presentationObject.size.isSuperLarge}

            superLargeLight = "font-sans-light text-3xl sm:text-4xl lg:text-5xl xl:text-5xl"
            superLargeLight.@if.1 = ${presentationObject.size.isSuperLargeLight}

            large = "font-sans-regular text-3xl sm:text-4xl lg:text-largeHeadline lg:leading-largeHeadline"
            large.@if.1 = ${presentationObject.size.isLarge}

            largeCentered = "font-sans-regular text-3xl sm:text-4xl lg:text-largeHeadline xl:text-largeHeadline mx-auto"
            largeCentered.@if.1 = ${presentationObject.size.isLargeCentered}

            medium = "font-sans-bold text-2xl sm:text-3xl lg:text-4xl xl:text-5xl"
            medium.@if.1 = ${presentationObject.size.isMedium}

            mediumItalic = "uppercase font-sans-light text-2xl sm:text-3xl lg:text-4xl xl:text-5xl [&_strong]:font-sans-bold"
            mediumItalic.@if.1 = ${presentationObject.size.isMediumItalic}

            small = "font-sans-bold text-2xl sm:text-3xl lg:text-4xl xl:text-4xl"
            small.@if.1 = ${presentationObject.size.isSmall}

            tile = "font-sans-regular text-2xl sm:text-3xl"
            tile.@if.1 = ${presentationObject.size.isTile}

            tiny = "font-sans-bold text-xl sm:text-2xl lg:text-3xl xl:text-3xl"
            tiny.@if.1 = ${presentationObject.size.isTiny}

            verySmall = "font-sans-bold text-lg"
            verySmall.@if.1 = ${presentationObject.size.isVerySmall}

            verySmallItalic = "text-xl [&_strong]:font-sans-bold"
            verySmallItalic.@if.1 = ${presentationObject.size.isVerySmallItalic}

            headerStage = "text-3xl [&_strong]:font-sans-bold"
            headerStage.@if.1 = ${presentationObject.size.isHeaderStage}

            verySmallRegular = "text-[20px] font-sans-regular"
            verySmallRegular.@if.1 = ${presentationObject.size.isVerySmallRegular}

            colorBrand = "text-brand"
            colorBrand.@if.1 = ${presentationObject.color.isBrand}

            colorWhite = "text-light"
            colorWhite.@if.1 = ${presentationObject.color.isWhite}

            colorExcite = "text-excite"
            colorExcite.@if.1 = ${presentationObject.color.isExcite}

            colorExciteContrast = "text-excite-contrast"
            colorExciteContrast.@if.1 = ${presentationObject.color.isExciteContrast}

            colorExperience = "text-experience"
            colorExperience.@if.1 = ${presentationObject.color.isExperience}

            colorExperienceContrast = "text-experience-contrast"
            colorExperienceContrast.@if.1 = ${presentationObject.color.isExperienceContrast}

            colorLite = "text-lite"
            colorLite.@if.1 = ${presentationObject.color.isLite}

            colorLiteContrast = "text-lite-contrast"
            colorLiteContrast.@if.1 = ${presentationObject.color.isLiteContrast}

            colorServiceContrast = "text-service-darker"
            colorServiceContrast.@if.1 = ${presentationObject.color.isServiceContrast}

            colorNeutralContrast = "text-neutral-contrast"
            colorNeutralContrast.@if.1 = ${presentationObject.color.isNeutralContrast}
        }

        content = PackageFactory.AtomicFusion.PresentationObjects:Slot {
            presentationObject = ${presentationObject.content}
        }
    }
}
