prototype(Hoerbiger.HoerbigerCom.SuccessStories:CacheSegment.SuccessStoryList) < prototype(Hoerbiger.Shared:CacheSegment) {
    @cache {
        entryIdentifier {
            documentNode = ${documentNode}
        }
        entryTags {
            1 = ${Neos.Caching.nodeTypeTag('Neos.Neos:Document', documentNode)}
            2 = ${Neos.Caching.nodeTypeTag('Hoerbiger.HoerbigerCom.SuccessStories:Document.SuccessStory')}
        }
    }
}
