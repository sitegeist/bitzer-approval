prototype(Hoerbiger.Shared:Layout.ContentContainer) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Layout\\ContentContainer\\ContentContainerInterface'

    @styleguide {
        title = 'ContentContainer'

        props {
            variant = 'regular'
            content = '- Add Slot Content -'
        }
    }

    renderer = afx`
        <div class={[
            "[Layout.ContentContainer (" + presentationObject.variant.value + ")]",
            "w-full",
            presentationObject.variant.equals('regularNeutral') && "bg-neutral-lighter",
            presentationObject.variant.equals('yCentered') && "h-full"
        ]}>
            <div class={[
                presentationObject.variant.equals('regular') && "max-w-content-full mx-auto px-md py-contentcontainer bg-light",
                presentationObject.variant.equals('regularWithoutBottom') && "max-w-content-full mx-auto px-md pt-contentcontainer pb-xs bg-light mb-minus-contentcontainer",
                presentationObject.variant.equals('regularNeutral') && "max-w-content-full mx-auto px-md py-contentcontainer",
                presentationObject.variant.equals('snug') && "max-w-content-snug mx-auto px-md py-contentcontainer bg-light",
                presentationObject.variant.equals('snugOverlay') && "w-content-full lg:w-[90%]  mx-auto lg:mt-[-180px] xl:mt-[-250px] px-md py-contentcontainer bg-light z-50 relative shadow-textbox",
                presentationObject.variant.equals('tight') && "max-w-content-tight mx-auto px-md py-contentcontainer bg-light",
                presentationObject.variant.equals('regularSm') && "max-w-content-full mx-auto pb-sm sm:p-sm bg-light",
                presentationObject.variant.equals('regularX') && "max-w-content-full mx-auto px-md bg-light",
                presentationObject.variant.equals('stageAfterBreadcrumb') && "max-w-content-full mx-auto p-md sm:p-sm py-0 sm:py-0 bg-light",
                presentationObject.variant.equals('regularStageAfterBreadcrumb') && "max-w-content-full mx-auto px-md pb-contentcontainer pt-0 bg-light",
                presentationObject.variant.equals('stackStage') && "max-w-content-full mx-auto px-md py-0 bg-light",
                presentationObject.variant.equals('blank') && "w-full",
                presentationObject.variant.equals('fullViewHeight') && "w-full h-screen",
                presentationObject.variant.equals('blankY') && "w-full py-contentcontainer",
                presentationObject.variant.equals('blankBottom') && "w-full pb-contentcontainer",
                presentationObject.variant.equals('halfWidth') && "border-brand w-full sm:max-w-[50%]",
                presentationObject.variant.equals('press') && "max-w-[1050px] mx-auto bg-light",
                presentationObject.variant.equals('pressSmall') && "max-w-[800px] mx-auto bg-light",
                presentationObject.variant.equals('pressLeft') && "max-w-[800px] pb-sm",
                presentationObject.variant.equals('pressLeftBlank') && "max-w-[800px]",
                presentationObject.variant.equals('yCentered') && "w-full h-full flex items-center",
                presentationObject.variant.equals('pressImage') && "w-full md:h-[600px] mx-auto px-0 md:px-md py-contentcontainer",
                presentationObject.variant.equals('visibleSm') && "hidden sm:block w-full h-full",
                presentationObject.variant.equals('visibleMd') && "hidden md:block w-full h-full",
                presentationObject.variant.equals('visibleLg') && "hidden lg:block w-full h-full",
                presentationObject.variant.equals('smallText') && "max-w-small-text mx-auto px-md py-contentcontainer bg-light"
            ]}>
                <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.content} />
            </div>
        </div>
    `
}
