prototype(Hoerbiger.Shared:Block.MatomoOptOut) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\MatomoOptOut\\MatomoOptOut'

    @styleguide {
        title = 'MatomoOptOut'

        props {
            src = 'https://www.neos.io'
        }
    }

    renderer = afx`<iframe
        style="width: 100%; height: 200px; border: 1px solid #000000D9;"
        src={presentationObject.src}>
    </iframe>`
}
