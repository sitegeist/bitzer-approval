prototype(Hoerbiger.Shared:CacheSegment) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Integration\\CacheSegment\\CacheSegment'
    renderer = PackageFactory.AtomicFusion.PresentationObjects:Slot {
        presentationObject = ${presentationObject.content}
    }

    @cache {
        mode = 'cached'
    }
}
