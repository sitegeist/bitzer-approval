prototype(Hoerbiger.Shared:Block.Figure) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Block\\Figure\\FigureInterface'

    @styleguide {
        title = 'Figure'

        props {
            imageSource = Sitegeist.Kaleidoscope:DummyImageSource {
                height = 1920
                width = 1080
            }
            isToBeLoadedLazily = true
            objectFit = 'cover'
            objectPosition = 'topLeft'
            caption = ' -- Add slot content here --'
        }
    }

    renderer = afx`
        <figure class={[
            "[Block.Figure (" + (presentationObject.objectFit || "no-objectFit") + ", " + (presentationObject.objectPosition || "no-objectPosition") + ")]",
            "flex flex-col max-h-full relative",
            (presentationObject.objectFit.isCover || presentationObject.objectFit.isContain) && "w-full h-full"
        ]}>
            <Sitegeist.Lazybones:Image
                imageSource={presentationObject.imageSource}
                alt={presentationObject.imageSource.alt}
                title={presentationObject.imageSource.title}
                srcset={presentationObject.sourceSet.srcset}
                sizes={presentationObject.sizes.sizes}
                lazy={presentationObject.isToBeLoadedLazily}
                class={Array.join(Array.filter([
                    "w-full h-full",
                    presentationObject.objectFit.isCover && "object-cover",
                    presentationObject.objectFit.isContain && "object-contain",
                    presentationObject.objectPosition.isCenter && "object-center",
                    presentationObject.objectPosition.isTop && "object-top",
                    presentationObject.objectPosition.isLeft && "object-left",
                    presentationObject.objectPosition.isRight && "object-right",
                    presentationObject.objectPosition.isBottom && "object-bottom",
                    presentationObject.objectPosition.isLeftTop && "object-left-top",
                    presentationObject.objectPosition.isLeftBottom && "object-left-bottom",
                    presentationObject.objectPosition.isRightTop && "object-right-top",
                    presentationObject.objectPosition.isRightBottom && "object-right-bottom"
                ]), ' ')}
            />
            <figcaption
                @if.1={presentationObject.caption}
                class="bg-light py-ch text-md text-neutral-darker"
            >
                <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.caption} />
            </figcaption>
        </figure>
    `
}
