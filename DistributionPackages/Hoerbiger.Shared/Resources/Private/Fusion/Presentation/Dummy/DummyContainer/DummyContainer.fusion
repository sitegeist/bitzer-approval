prototype(Hoerbiger.Shared:Dummy.DummyContainer) < prototype(PackageFactory.AtomicFusion.PresentationObjects:PresentationObjectComponent) {
    @presentationObjectInterface = 'Hoerbiger\\Shared\\Presentation\\Dummy\\DummyContainer\\DummyContainerInterface'

    renderer = afx`
        <div style={'
            background-color: #CCCCCC;
            background-image: url("' + presentationObject.sampleImageUri + '");
            background-repeat: repeat-x;
            background-position: left;
        '}>
            <PackageFactory.AtomicFusion.PresentationObjects:Slot presentationObject={presentationObject.content} />
        </div>`
}
